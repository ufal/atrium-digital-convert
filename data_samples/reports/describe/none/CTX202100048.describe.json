.467,524.042,388.507],"group_id":"p4-1","quality_score":1.0},{"page":"4","line":14,"text":"6 Cíle a metoda výzkumu ................................................................................................................. 16","bbox":[70.824,397.891,524.056,408.931],"group_id":"p4-1","quality_score":1.0},{"page":"4","line":15,"text":"Metodika výzkumu ............................................................................................................................ 17","bbox":[81.864,418.415,524.036,429.455],"group_id":"p4-1","quality_score":1.0},{"page":"4","line":16,"text":"7 Popis terénní situace ..................................................................................................................... 17","bbox":[70.824,438.816,524.038,449.856],"group_id":"p4-1","quality_score":1.0},{"page":"4","line":17,"text":"8 Zhodnocení výsledků výzkumu a závěr ......................................................................................... 19","bbox":[70.824,459.218,523.677,470.258],"group_id":"p4-1","quality_score":1.0},{"page":"4","line":18,"text":"9 Seznam literatury .......................................................................................................................... 23","bbox":[70.835,479.742,524.045,490.782],"group_id":"p4-1","quality_score":1.0},{"page":"4","line":19,"text":"10","bbox":[70.835,500.144,82.074,511.184],"group_id":"p4-1","quality_score":1.0},{"page":"4","line":20,"text":"Přílohy ........................................................................................................................................ 24","bbox":[103.834,500.144,524.045,511.184],"group_id":"p4-1","quality_score":1.0},{"page":"4","line":21,"text":"1 Plánová dokumentace ............................................................................................................... 25","bbox":[81.875,520.667,524.084,531.707],"group_id":"p4-1","quality_score":1.0},{"page":"4","line":22,"text":"2 Obrazová příloha ....................................................................................................................... 26","bbox":[81.875,541.069,524.115,552.109],"group_id":"p4-1","quality_score":1.0},{"page":"4","line":23,"text":"3 Dokumentace nálezů................................................................................................................. 27","bbox":[81.886,561.493,523.568,572.533],"group_id":"p4-1","quality_score":1.0},{"page":"4","line":24,"text":"4 Fotogrammetrická dokumentace archeologických situací ....................................................... 28","bbox":[81.886,582.016,523.938,593.056],"group_id":"p4-1","quality_score":1.0},{"page":"4","line":25,"text":"5 Seznam vrstev, objektů, výzkumných polygonů, řezů, nálezů.................................................. 29","bbox":[81.886,602.418,523.928,613.458],"group_id":"p4-1","quality_score":1.0},{"page":"4","line":26,"text":"6 Seznam geodetických bodů....................................................................................................... 30","bbox":[81.886,622.82,523.613,633.86],"group_id":"p4-1","quality_score":1.0},{"page":"4","line":27,"text":"4","bbox":[294.89,781.92,300.487,792.96],"group_id":"p4-2","quality_score":1.0,"style":{"region":"page_footer"}},{"page":"5","line":0,"text":"1","bbox":[70.824,81.65,77.942,95.69],"group_id":"p5-0","quality_score":1.0,"style":{"bold":true,"heading_level":3}},{"page":"5","line":1,"text":"Úvod","bbox":[106.837,81.65,137.675,95.69],"group_id":"p5-0","quality_score":1.0,"style":{"bold":true,"heading_level":3}},{"page":"5","line":2,"text":"Záchranný archeologický výzkum uskutečněný ve městě Sázava byl vyvolán záměrem","bbox":[106.22,106.94,524.5,118.94],"group_id":"p5-1","quality_score":1.0},{"page":"5","line":3,"text":"investora zbudovat komunikaci a IS pro následnou výstavbu RD. Výzkum proběhl v březnu","bbox":[70.82,128.9,524.66,140.9],"group_id":"p5-1","quality_score":1.0},{"page":"5","line":4,"text":"roku 2019 na základě dohody o provedení záchranného archeologického výzkumu uzavřené","bbox":[70.832,150.86,524.192,162.86],"group_id":"p5-1","quality_score":1.0},{"page":"5","line":5,"text":"mezi oprávněnou organizací Pueblo - archeologická společnost, o. p. s. a stavebníkem,","bbox":[70.832,172.82,524.587,184.82],"group_id":"p5-1","quality_score":1.0},{"page":"5","line":6,"text":"společností Nové Mlýny s.r.o.","bbox":[70.832,194.78,214.023,206.78],"group_id":"p5-1","quality_score":1.0},{"page":"5","line":7,"text":"2","bbox":[70.824,235.28,77.942,249.32],"group_id":"p5-2","quality_score":1.0,"style":{"bold":true,"heading_level":3}},{"page":"5","line":8,"text":"Lokalizace výzkumu","bbox":[106.823,235.28,221.32,249.32],"group_id":"p5-2","quality_score":1.0,"style":{"bold":true,"heading_level":3}},{"page":"5","line":9,"text":"Zájmový prostor archeologického výzkumu se nacházel na JZ okraji města Sázava (okr.","bbox":[106.22,260.45,524.466,272.45],"group_id":"p5-3","quality_score":1.0},{"page":"5","line":10,"text":"Benešov), v prostoru bývalého rekreačního objektu RaJ ležícího na Z od ul. Pod Zastávkou.","bbox":[70.82,282.41,524.542,294.41],"group_id":"p5-3","quality_score":1.0},{"page":"5","line":11,"text":"Dotčené parcely nesou č. 1297/1, 1297/3 a 1297/4 (viz přílohu 1, plán 1–5).","bbox":[70.82,304.37,438.14,316.37],"group_id":"p5-3","quality_score":1.0},{"page":"5","line":12,"text":"3","bbox":[70.824,344.84,77.942,358.88],"group_id":"p5-4","quality_score":1.0,"style":{"bold":true,"heading_level":3}},{"page":"5","line":13,"text":"Přírodní podmínky na lokalitě","bbox":[106.219,344.84,278.616,358.88],"group_id":"p5-4","quality_score":1.0,"style":{"bold":true,"heading_level":3}},{"page":"5","line":14,"text":"Geomorfologie","bbox":[70.824,380.21,151.957,393.17],"group_id":"p5-5","quality_score":1.0,"style":{"bold":true}},{"page":"5","line":15,"text":"Zájmové území náleží z geomorfologického hlediska k provincii Česká vysočina,","bbox":[106.22,398.23,524.104,410.23],"group_id":"p5-5","quality_score":1.0},{"page":"5","line":16,"text":"Česko-moravské subprovincii, oblasti Středočeská tabule, celku Benešovská pahorkatina,","bbox":[70.82,420.19,524.616,432.19],"group_id":"p5-5","quality_score":1.0},{"page":"5","line":17,"text":"podcelku Dobříšská pahorkatina a okrsku Divišovská vrchovina (mapa č. 1).","bbox":[70.82,442.15,434.592,454.15],"group_id":"p5-5","quality_score":1.0},{"page":"5","line":18,"text":"Mapa č. 1: Geomorfologické členění zájmového území. Poloha lokality je označena šipkou.","bbox":[114.38,726.33,480.946,736.29],"group_id":"p5-6","quality_score":1.0,"style":{"bold":true}},{"page":"5","line":19,"text":"Zdroj: https://geoportal.gov.cz. [15. 10 2020]","bbox":[205.972,744.567,389.187,754.527],"group_id":"p5-6","quality_score":1.0},{"page":"5","line":20,"text":"5","bbox":[294.89,781.92,300.487,792.96],"group_id":"p5-7","quality_score":1.0,"style":{"region":"page_footer"}},{"page":"6","line":0,"text":"Geologie","bbox":[70.824,73.46,118.645,86.42],"group_id":"p6-0","quality_score":1.0,"style":{"bold":true}},{"page":"6","line":1,"text":"Lokalita leží v oblasti Blanické brázdy, významného systému zlomů zčásti rázu","bbox":[106.22,91.46,524.468,103.46],"group_id":"p6-0","quality_score":1.0},{"page":"6","line":2,"text":"příkopové propadliny, který se táhne od Českého Brodu přes Tábor až na jih do Rakouska.","bbox":[70.832,113.54,524.284,125.54],"group_id":"p6-0","quality_score":1.0},{"page":"6","line":3,"text":"Vyznačuje se zakleslými permokarbonskými sedimenty a polymetalickým (Ag, Pb, Zn, Cu, Au)","bbox":[70.832,135.5,524.701,147.5],"group_id":"p6-0","quality_score":1.0},{"page":"6","line":4,"text":"zrudněním. Brázda vznikla před 305 až 300 miliony lety. Na východ od brázdy lze najít","bbox":[70.832,157.46,524.598,169.46],"group_id":"p6-0","quality_score":1.0},{"page":"6","line":5,"text":"především ruly vzniklé v prekambriu či paleozoiku, které tvoří podloží na velké části","bbox":[70.832,179.42,524.444,191.42],"group_id":"p6-0","quality_score":1.0},{"page":"6","line":6,"text":"Českomoravské vrchoviny. Na západní straně (kde se nachází i prostor výzkumu) lze","bbox":[70.832,201.38,524.389,213.38],"group_id":"p6-0","quality_score":1.0},{"page":"6","line":7,"text":"pozorovat variská intruziva – alkalickoživcové a muskovitické granity, leukogranity. Lokálně","bbox":[70.832,223.34,524.576,235.34],"group_id":"p6-0","quality_score":1.0},{"page":"6","line":8,"text":"jsou v okolí přítomny také prekambrické a paleozoické vulkanity a metavulkanity, konkrétně","bbox":[70.832,245.336,524.672,257.336],"group_id":"p6-0","quality_score":1.0},{"page":"6","line":9,"text":"amfibolity (mapa č. 2).","bbox":[70.832,267.296,180.29,279.296],"group_id":"p6-0","quality_score":1.0},{"page":"6","line":10,"text":"Mapa č. 2: Geologické členění zájmové oblasti. Meruňková: migmatitizované ruly, migmatity, převážně","bbox":[106.46,552.91,523.983,562.87],"group_id":"p6-1","quality_score":1.0,"style":{"bold":true}},{"page":"6","line":11,"text":"stromatitické a flebilitické. Červená: alkalickoživcové a muskovitické granity, leukogranity. Zelená: amfibolity,","bbox":[76.7,571.266,518.495,581.226],"group_id":"p6-1","quality_score":1.0},{"page":"6","line":12,"text":"granátické amfibolity. Zdroj: https://geoportal.gov.cz. [15. 10 2020]","bbox":[160.692,589.503,434.533,599.463],"group_id":"p6-1","quality_score":1.0},{"page":"6","line":13,"text":"Pedologie","bbox":[70.824,626.38,124.232,639.34],"group_id":"p6-2","quality_score":1.0,"style":{"bold":true}},{"page":"6","line":14,"text":"Půdní pokryv lokality je poměrně homogenní. Zástavbu města Sázava i širší okolí","bbox":[106.22,644.38,524.412,656.38],"group_id":"p6-2","quality_score":1.0},{"page":"6","line":15,"text":"pokrývá kambizem, „lesní půda“, nejrozšířenější půdní typ na území ČR. Přímo na místě jde o","bbox":[70.82,666.34,524.546,678.34],"group_id":"p6-2","quality_score":1.0},{"page":"6","line":16,"text":"modální subtyp, vznikající na svahovinách rul, rozšíříná je v okolí také kambizem acidická,","bbox":[70.82,688.3,524.496,700.3],"group_id":"p6-2","quality_score":1.0},{"page":"6","line":17,"text":"vznikající na svahovinách kyselých žul. V okolí Stříbrné Skalice lze nalézt kambizem eutrofní,","bbox":[70.82,710.26,524.42,722.26],"group_id":"p6-2","quality_score":1.0},{"page":"6","line":18,"text":"vznikající na svahovinách dalších bazických hornin. Od Úžice na SV pak leží oblast pokrytá","bbox":[70.82,732.244,524.325,744.244],"group_id":"p6-2","quality_score":1.0},{"page":"6","line":19,"text":"modální luvizemí, jejímž substrátem je prachovice (mapa č. 3).","bbox":[70.82,754.204,373.858,766.204],"group_id":"p6-2","quality_score":1.0},{"page":"6","line":20,"text":"6","bbox":[294.89,781.92,300.487,792.96],"group_id":"p6-3","quality_score":1.0,"style":{"region":"page_footer"}},{"page":"7","line":0,"text":"Mapa č. 3: Půdní členění zájmové oblasti. Meruňková: kambizem modální/kyselá. Hnědá: kambizem eutrofní.","bbox":[75.624,330.86,519.445,340.82],"group_id":"p7-0","quality_score":1.0,"style":{"bold":true}},{"page":"7","line":1,"text":"Růžová: luvizem modální. Zdroj: https://geoportal.gov.cz. [15. 10 2020]","bbox":[153.133,349.216,441.973,359.176],"group_id":"p7-0","quality_score":1.0},{"page":"7","line":2,"text":"Klimatické podmínky","bbox":[70.824,385.97,183.978,398.93],"group_id":"p7-1","quality_score":1.0,"style":{"bold":true}},{"page":"7","line":3,"text":"Z hlediska základních klimatologických charakteristik dle Quitta (1971) leží lokalita","bbox":[106.22,403.99,524.565,415.99],"group_id":"p7-1","quality_score":1.0},{"page":"7","line":4,"text":"v mírně teplé oblasti T 11:","bbox":[70.82,425.95,200.148,437.95],"group_id":"p7-1","quality_score":1.0},{"page":"7","line":5,"text":"� Počet letních dnů: 40–50","bbox":[124.22,453.43,263.665,465.91],"group_id":"p7-2","quality_score":0.9545},{"page":"7","line":6,"text":"� Počet dnů v roce s teplotou 10 °C a více: 140–160","bbox":[124.22,474.07,383.15,486.55],"group_id":"p7-2","quality_score":0.975},{"page":"7","line":7,"text":"� Počet mrazových dnů: 110-130","bbox":[124.22,494.83,293.179,507.31],"group_id":"p7-2","quality_score":0.9615},{"page":"7","line":8,"text":"� Počet ledových dnů: 30–40","bbox":[124.22,515.47,274.112,527.95],"group_id":"p7-2","quality_score":0.9565},{"page":"7","line":9,"text":"� Průměrná teplota v lednu −2 až −3 °C","bbox":[124.22,536.11,322.929,548.59],"group_id":"p7-2","quality_score":0.9667},{"page":"7","line":10,"text":"� Průměrná teplota v dubnu 7 až 8 °C","bbox":[124.22,556.774,314.892,569.254],"group_id":"p7-2","quality_score":0.9643},{"page":"7","line":11,"text":"� Průměrná teplota v červenci 17 až 18 °C","bbox":[124.22,577.414,336.451,589.894],"group_id":"p7-2","quality_score":0.9697},{"page":"7","line":12,"text":"� Průměrná teplota v říjnu 7 až 8 °C","bbox":[124.22,598.054,305.822,610.534],"group_id":"p7-2","quality_score":0.9643},{"page":"7","line":13,"text":"� Průměrný počet dnů za rok se srážkami nad 1 mm: 90–110","bbox":[124.22,618.694,427.687,631.174],"group_id":"p7-2","quality_score":0.9778},{"page":"7","line":14,"text":"� Srážkový úhrn za vegetační období 350–400 mm","bbox":[124.22,639.334,377.875,651.814],"group_id":"p7-2","quality_score":0.9744},{"page":"7","line":15,"text":"� Srážkový úhrn v zimním období 200–250 mm","bbox":[124.22,659.974,361.666,672.454],"group_id":"p7-2","quality_score":0.9714},{"page":"7","line":16,"text":"� Počet dnů v roce se sněhovou pokrývkou: 50–60","bbox":[124.22,680.614,377.919,693.094],"group_id":"p7-2","quality_score":0.9744},{"page":"7","line":17,"text":"� Počet dnů zamračených: 120–150","bbox":[124.22,701.254,306.829,713.746],"group_id":"p7-2","quality_score":0.9643},{"page":"7","line":18,"text":"� Počet dnů jasných: 40–50","bbox":[124.22,721.924,266.905,734.404],"group_id":"p7-2","quality_score":0.9545},{"page":"7","line":19,"text":"7","bbox":[294.89,781.92,300.487,792.96],"group_id":"p7-3","quality_score":1.0,"style":{"region":"page_footer"}},{"page":"8","line":0,"text":"Vegetace","bbox":[70.824,73.46,120.519,86.42],"group_id":"p8-0","quality_score":1.0,"style":{"bold":true}},{"page":"8","line":1,"text":"Potenciálně přirozenou vegetací lokality i širšího okolí je lipová bučina s lípou srdčitou","bbox":[106.22,91.46,524.258,103.46],"group_id":"p8-0","quality_score":1.0},{"page":"8","line":2,"text":"(Tilio cordatae-Fagetum), patřící ke svazu listnatých lesů s převládajícím bukem lesním, který","bbox":[70.82,113.54,524.385,125.54],"group_id":"p8-0","quality_score":1.0,"style":{"italic":true}},{"page":"8","line":3,"text":"může být doprovázen příměsí dalších listnáčů. Ve vyšších polohách nebo na stinných","bbox":[70.832,135.5,524.234,147.5],"group_id":"p8-0","quality_score":1.0},{"page":"8","line":4,"text":"severních svazích jsou v porostech zastoupeny jedle bělokorá a smrk ztepilý. Smrk","bbox":[70.832,157.46,524.42,169.46],"group_id":"p8-0","quality_score":1.0},{"page":"8","line":5,"text":"je přirozenou příměsí montánních bučin, ale v nižších polohách se přirozeně vyskytuje jen na","bbox":[70.832,179.42,524.521,191.42],"group_id":"p8-0","quality_score":1.0},{"page":"8","line":6,"text":"vlhčích půdách. Přirozené zastoupení jedle je dosti proměnlivé a závisí hlavně na historickém","bbox":[70.832,201.38,524.446,213.38],"group_id":"p8-0","quality_score":1.0},{"page":"8","line":7,"text":"managementu konkrétních porostů; jedliny jsou spíše vzácné.","bbox":[70.832,223.34,371.229,235.34],"group_id":"p8-0","quality_score":1.0},{"page":"8","line":8,"text":"V bylinném patře se vyskytují mezofilní druhy listnatých lesů. Pokryvnost bylinného","bbox":[106.232,257.336,524.596,269.336],"group_id":"p8-1","quality_score":1.0},{"page":"8","line":9,"text":"patra zpravidla nepřesahuje 30 %, na vlhčích stanovištích bývá větší.","bbox":[70.832,279.296,402.265,291.296],"group_id":"p8-1","quality_score":1.0},{"page":"8","line":10,"text":"Květnaté bučiny se vyskytují na eutrofních půdách, obvykle kambizemích s rychlou","bbox":[106.232,313.256,524.314,325.256],"group_id":"p8-2","quality_score":1.0},{"page":"8","line":11,"text":"mineralizací humusu, a to na různých druzích hornin. Na horninách minerálně chudých nebo","bbox":[70.832,335.336,524.188,347.336],"group_id":"p8-2","quality_score":1.0},{"page":"8","line":12,"text":"na vápencích se vyskytují pouze na plošinách nebo mírných svazích, kde je vyvinuta hluboká","bbox":[70.832,357.296,524.45,369.296],"group_id":"p8-2","quality_score":1.0},{"page":"8","line":13,"text":"půda, která omezuje vliv chemismu horniny na vegetaci.","bbox":[70.832,379.256,344.514,391.256],"group_id":"p8-2","quality_score":1.0},{"page":"8","line":14,"text":"V nižších a středních nadmořských výškách osídlují chladnější rokle a severní svahy,","bbox":[106.232,413.24,524.131,425.24],"group_id":"p8-3","quality_score":1.0},{"page":"8","line":15,"text":"v podhorských a horských oblastech přecházejí na plošiny a svahy všech orientací. Jen","bbox":[70.832,435.2,524.134,447.2],"group_id":"p8-3","quality_score":1.0},{"page":"8","line":16,"text":"výjimečně rostou v nadmořské výšce nad 1 000 m. Květnaté jedliny jsou vázány spíše na","bbox":[70.832,457.148,524.165,469.16],"group_id":"p8-3","quality_score":1.0},{"page":"8","line":17,"text":"těžší, střídavě vlhké půdy, ale mohou růst i na propustných skeletovitých půdách.","bbox":[70.824,479.11,465.715,491.11],"group_id":"p8-3","quality_score":1.0},{"page":"8","line":18,"text":"Bučiny jsou rozšířeny v podhorských a horských oblastech na celém území České","bbox":[106.224,513.07,524.087,525.07],"group_id":"p8-4","quality_score":1.0},{"page":"8","line":19,"text":"republiky. Hlavní oblastí jejich výskytu jsou okrajová pohoří Českého masivu, Českomoravská","bbox":[70.824,535.03,524.333,547.03],"group_id":"p8-4","quality_score":1.0},{"page":"8","line":20,"text":"a Drahanská vrchovina, vyšších pahorkatiny a hornatiny ve vnitrozemí Čech a prakticky","bbox":[70.824,557.134,524.117,569.134],"group_id":"p8-4","quality_score":1.0},{"page":"8","line":21,"text":"všechny pohoří moravských Karpat (Chytrý – Kučera – Kočí – Grulich – Lustyk 2010).","bbox":[70.824,579.094,478.154,591.094],"group_id":"p8-4","quality_score":1.0},{"page":"8","line":22,"text":"8","bbox":[294.89,781.92,300.487,792.96],"group_id":"p8-5","quality_score":1.0,"style":{"region":"page_footer"}},{"page":"9","line":0,"text":"Mapa č. 4: Rekonstrukce potenciální přirozené vegetace. Tyrkysová s rastrem: lipová bučina s lípou srdčitou.","bbox":[77.903,341.659,517.284,351.619],"group_id":"p9-0","quality_score":1.0,"style":{"bold":true}},{"page":"9","line":1,"text":"Zdroj: https://geoportal.gov.cz. [15. 10 2020]","bbox":[205.969,359.895,389.184,369.855],"group_id":"p9-0","quality_score":1.0},{"page":"9","line":2,"text":"Hydrologie","bbox":[70.824,390.79,129.758,403.75],"group_id":"p9-1","quality_score":1.0,"style":{"bold":true}},{"page":"9","line":3,"text":"Sledovaná oblast leží v bezprostředním okolí koryta řeky Sázavy, pravostranného","bbox":[106.22,408.79,524.539,420.79],"group_id":"p9-1","quality_score":1.0},{"page":"9","line":4,"text":"přítoku Vltavy. Plocha povodí horní Sázavy po soutok se Želivkou činí 1 508 km 2 a její délka je","bbox":[70.832,429.76,524.504,442.75],"group_id":"p9-1","quality_score":1.0},{"page":"9","line":5,"text":"v tomto úseku 127 km. Průměrný průtok při soutoku s Želivkou dosahuje necelých 10 m³.","bbox":[70.828,452.71,504.567,464.71],"group_id":"p9-1","quality_score":1.0},{"page":"9","line":6,"text":"Sázava pramení ve Žďárských vrších v nadmořské výšce 757 m n. m. Asi o 3 km dále","bbox":[106.228,484.75,524.438,496.75],"group_id":"p9-2","quality_score":1.0},{"page":"9","line":7,"text":"ústí Sázava do rybníka Velké Dářko, který byl vybudován polovině 15. století pro pohon","bbox":[70.84,506.71,524.352,518.71],"group_id":"p9-2","quality_score":1.0},{"page":"9","line":8,"text":"hamrů. Zbudování rozlehlého (plocha 205 ha, objem vody 3,56 mil. m) rybníka nedaleko","bbox":[70.84,528.67,524.391,540.67],"group_id":"p9-2","quality_score":1.0},{"page":"9","line":9,"text":"prameniště mělo za následek rozšíření rašelinišť v plochém rozvodí Českomoravské","bbox":[70.84,550.666,524.301,562.666],"group_id":"p9-2","quality_score":1.0},{"page":"9","line":10,"text":"vrchoviny.","bbox":[70.84,572.626,121.106,584.626],"group_id":"p9-2","quality_score":1.0},{"page":"9","line":11,"text":"Z Velkého Dářka teče Sázava poměrně širokou nivou k městu Žďár. Zde se trasa","bbox":[106.24,604.666,524.574,616.666],"group_id":"p9-3","quality_score":1.0},{"page":"9","line":12,"text":"Sázavy ostře láme západním směrem na Přibyslav, Havlíčků Brod, Ledeč nad Sázavou a Zruč","bbox":[70.84,626.626,524.56,638.626],"group_id":"p9-3","quality_score":1.0},{"page":"9","line":13,"text":"nad Sázavou. Soutok Sázavy se Želivkou leží v nadmořské výšce 310 m.","bbox":[70.84,648.586,413.529,660.586],"group_id":"p9-3","quality_score":1.0},{"page":"9","line":14,"text":"Spád řeky, zejména na jejím horním toku, je poměrně velký. Od Velkého Dářka po","bbox":[106.228,680.506,524.063,692.506],"group_id":"p9-4","quality_score":1.0},{"page":"9","line":15,"text":"Světlou nad Sázavou je však zpomalován řadou jezů. Mezi Žďárem nad Sázavou a Přibyslaví","bbox":[70.828,702.466,524.181,714.466],"group_id":"p9-4","quality_score":1.0},{"page":"9","line":16,"text":"řeka protéká údolí s velkým spádem a peřejemi. Za Přibyslaví se údolí otevírá a řeka","bbox":[70.828,724.45,524.306,736.45],"group_id":"p9-4","quality_score":1.0},{"page":"9","line":17,"text":"meandruje k Havlíčkovu Brodu.","bbox":[70.828,746.53,223.089,758.53],"group_id":"p9-4","quality_score":1.0},{"page":"9","line":18,"text":"9","bbox":[294.89,781.92,300.487,792.96],"group_id":"p9-5","quality_score":1.0,"style":{"region":"page_footer"}},{"page":"10","line":0,"text":"Největším přítokem Sázavy po soutok se Želivkou je Šlapanka, která se do Sázavy","bbox":[106.22,73.22,524.11,85.22],"group_id":"p10-0","quality_score":1.0},{"page":"10","line":1,"text":"vlévá zleva Havlíčkově Brodě. Nejvýznamnějším pravostranným přítokem Sázavy je Sázavka,","bbox":[70.82,95.3,524.421,107.3],"group_id":"p10-0","quality_score":1.0},{"page":"10","line":2,"text":"která se do ní vlévá ve Světlé nad Sázavou (Anonymus 2016).","bbox":[70.82,117.26,366.885,129.26],"group_id":"p10-0","quality_score":1.0},{"page":"10","line":3,"text":"4 Historie Sázavy","bbox":[70.824,163.61,180.381,177.65],"group_id":"p10-1","quality_score":1.0,"style":{"bold":true,"heading_level":3}},{"page":"10","line":4,"text":"Historie města Sázava je spojena s třetím nejstarším mužským klášterem v Čechách.","bbox":[106.22,188.9,524.631,200.9],"group_id":"p10-2","quality_score":1.0},{"page":"10","line":5,"text":"Klášter se nachází v místech, kde se počátkem 11. století usadil poustevník Prokop. Ten zde","bbox":[70.832,210.86,524.41,222.86],"group_id":"p10-2","quality_score":1.0},{"page":"10","line":6,"text":"po roce 1009 shromáždil komunitu poustevníků, která získala podporu přemyslovských","bbox":[70.832,232.856,524.173,244.856],"group_id":"p10-2","quality_score":1.0},{"page":"10","line":7,"text":"knížat. Kolem roku 1032 vzniká díky přemyslovským knížatům Oldřichovi a jeho synovi","bbox":[70.832,254.816,524.559,266.816],"group_id":"p10-2","quality_score":1.0},{"page":"10","line":8,"text":"Břetislavovi vlastní klášter.","bbox":[70.832,276.776,200.488,288.776],"group_id":"p10-2","quality_score":1.0},{"page":"10","line":9,"text":"Zvláštností kláštera bylo po celé 11. století slovanská liturgie. Klášter tak navázal na","bbox":[106.232,308.696,524.377,320.696],"group_id":"p10-3","quality_score":1.0},{"page":"10","line":10,"text":"někdejší dědictví věrozvěstů Velké Moravy sv. Cyrila a sv. Metoděje. Slovanští benediktini","bbox":[70.832,330.656,524.095,342.656],"group_id":"p10-3","quality_score":1.0},{"page":"10","line":11,"text":"v Sázavě vytvořili řadu významných slovanských písemných památek.","bbox":[70.832,352.736,406.731,364.736],"group_id":"p10-3","quality_score":1.0},{"page":"10","line":12,"text":"V roce 1055 za vlády knížete Spytihněva II. byli Prokopovi žáci ze Sázavy vyhnáni do","bbox":[106.232,384.656,524.506,396.656],"group_id":"p10-4","quality_score":1.0},{"page":"10","line":13,"text":"Uher. O šest let později byli povoláni zpět do Sázavy knížetem a budoucím prvním českým","bbox":[70.832,406.64,524.221,418.64],"group_id":"p10-4","quality_score":1.0},{"page":"10","line":14,"text":"králem Vratislavem I. V tomto období byl vybudován v klášterním areálu první kamenný","bbox":[70.832,428.6,524.175,440.6],"group_id":"p10-4","quality_score":1.0},{"page":"10","line":15,"text":"kostel. Zasvěcen byl v roce 1070 sv. Kříži a sloužil laikům pracujícím pro klášter.","bbox":[70.832,450.56,454.603,462.56],"group_id":"p10-4","quality_score":1.0},{"page":"10","line":16,"text":"Za vlády knížete Břetislava II. v roce 1096, byli řeholníci sloužící staroslověnské liturgii","bbox":[108.991,482.6,524.534,494.6],"group_id":"p10-5","quality_score":1.0},{"page":"10","line":17,"text":"podruhé a nadobro vyhnáni a jejich knihy a veškeré spisy zničeny. Klášter byl poté natrvalo","bbox":[70.832,504.56,524.173,516.56],"group_id":"p10-5","quality_score":1.0},{"page":"10","line":18,"text":"předán benediktinům z Břevnova a pěstovala se zde nadále pouze liturgie latinská. Stavební","bbox":[70.832,526.52,524.618,538.52],"group_id":"p10-5","quality_score":1.0},{"page":"10","line":19,"text":"rozmach je spojen se jménem opata Sylvestra (†1161), který byl krátce též pražským","bbox":[70.832,548.48,524.242,560.48],"group_id":"p10-5","quality_score":1.0},{"page":"10","line":20,"text":"biskupem. Sázavský opat Sylvestr vynikl jako hospodář a položil základy klášterního","bbox":[70.832,570.476,524.236,582.476],"group_id":"p10-5","quality_score":1.0},{"page":"10","line":21,"text":"komplexu v románském slohu.","bbox":[70.832,592.436,219.514,604.436],"group_id":"p10-5","quality_score":1.0},{"page":"10","line":22,"text":"Krátce po své korunovaci v roce 1203 se Přemysl Otakar I. snažil přesvědčit papeže","bbox":[106.232,624.476,524.479,636.476],"group_id":"p10-6","quality_score":1.0},{"page":"10","line":23,"text":"Inocence III. o povýšení pražského biskupství na arcibiskupství a prohlášení Prokopa za","bbox":[70.832,646.436,524.06,658.436],"group_id":"p10-6","quality_score":1.0},{"page":"10","line":24,"text":"svatého. Zatímco povýšení biskupství nebylo vyslyšeno, kanonizace svatého Prokopa","bbox":[70.832,668.396,524.114,680.396],"group_id":"p10-6","quality_score":1.0},{"page":"10","line":25,"text":"proběhla v roce 1204.","bbox":[70.832,690.356,177.127,702.356],"group_id":"p10-6","quality_score":1.0},{"page":"10","line":26,"text":"10","bbox":[292.01,781.92,303.249,792.96],"group_id":"p10-7","quality_score":1.0,"style":{"region":"page_footer"}},{"page":"11","line":0,"text":"Počátkem 14. století za opata Matyáše byl rozestavěn nový kostel i klášter v gotickém","bbox":[106.22,73.22,524.358,85.22],"group_id":"p11-0","quality_score":1.0},{"page":"11","line":1,"text":"slohu. V roce 1421 však vtrhla do Sázavy husitská vojska Pražanů, všichni mniši i stavebníci","bbox":[70.82,95.3,524.112,107.3],"group_id":"p11-0","quality_score":1.0},{"page":"11","line":2,"text":"byli vyhnáni a stavba byla přerušena. Část klášterního majetku přešla do rukou šlechty.","bbox":[70.82,117.26,492.835,129.26],"group_id":"p11-0","quality_score":1.0},{"page":"11","line":3,"text":"Ke konsolidaci majetku a postavení kláštera došlo až v době rekatolizace Čech","bbox":[106.208,149.18,524.307,161.18],"group_id":"p11-1","quality_score":1.0},{"page":"11","line":4,"text":"v 17. století. Během 17. a 18. století byl presbytář kostela přestavěn na nový barokní kostel a","bbox":[70.808,171.14,524.115,183.14],"group_id":"p11-1","quality_score":1.0},{"page":"11","line":5,"text":"barokně přestavěny i klášterní budovy.","bbox":[70.808,193.1,259.693,205.1],"group_id":"p11-1","quality_score":1.0},{"page":"11","line":6,"text":"Klášter byl zrušen roku 1785, kostel se stal farním a budovy kláštera proměněny na","bbox":[106.208,225.14,524.172,237.14],"group_id":"p11-2","quality_score":1.0},{"page":"11","line":7,"text":"zámek, upravený do roku 1870 novorenesančně. Dnes se v místě nachází expozice historie","bbox":[70.808,247.136,524.425,259.136],"group_id":"p11-2","quality_score":1.0},{"page":"11","line":8,"text":"kláštera.","bbox":[70.808,269.096,112.446,281.096],"group_id":"p11-2","quality_score":1.0},{"page":"11","line":9,"text":"Osada Sázava postupně přirozeně vyrostla okolo dříve založeného kláštera. Poprvé je","bbox":[106.208,301.016,524.504,313.016],"group_id":"p11-3","quality_score":1.0},{"page":"11","line":10,"text":"zmiňována již v roce 1053, Černé Budy (Schwarzbuda, Klosterdorf) pak v roce 1598. V roce","bbox":[70.808,322.976,524.522,334.976],"group_id":"p11-3","quality_score":1.0},{"page":"11","line":11,"text":"1436 je osada Sázava při zástavě císaře Zikmunda označena jako městečko.","bbox":[70.808,345.056,435.488,357.056],"group_id":"p11-3","quality_score":1.0},{"page":"11","line":12,"text":"Původní ves na pravém břehu Sázavy je nyní součástí městské části Černé Budy.","bbox":[106.22,376.976,524.149,388.976],"group_id":"p11-4","quality_score":1.0},{"page":"11","line":13,"text":"Jménem „Sázava“ se osada začala označovat až v poměrně nedávné historii","bbox":[70.82,398.96,524.625,410.96],"group_id":"p11-4","quality_score":1.0},{"page":"11","line":14,"text":"(http://isad.npu.cz,","bbox":[70.82,420.908,165.022,432.92],"group_id":"p11-4","quality_score":1.0},{"page":"11","line":15,"text":"https://www.klaster-sazava.cz/cs/o-klasteru/dejiny-sazavskeho-","bbox":[211.618,420.91,524.711,432.91],"group_id":"p11-4","quality_score":1.0},{"page":"11","line":16,"text":"klastera).","bbox":[70.824,442.87,116.098,454.87],"group_id":"p11-4","quality_score":1.0},{"page":"11","line":17,"text":"5 Lokalita ve státním archeologickém seznamu","bbox":[70.824,489.34,352.013,503.38],"group_id":"p11-5","quality_score":1.0,"style":{"bold":true,"heading_level":3}},{"page":"11","line":18,"text":"Lokalita se nachází v katastrálním území Sázava, jehož hranici tvoří koryto","bbox":[106.22,520.51,524.299,532.51],"group_id":"p11-6","quality_score":1.0},{"page":"11","line":19,"text":"stejnojmenné řeky, na jejímž levém břehu leží. Historicky je Sázava nicméně nerozlučně","bbox":[70.82,542.47,524.276,554.47],"group_id":"p11-6","quality_score":1.0},{"page":"11","line":20,"text":"spjata s územím na pravém břehu řeky, které leží v katastru Černé Budy. Na katastru Sázava","bbox":[70.82,564.466,524.39,576.466],"group_id":"p11-6","quality_score":1.0},{"page":"11","line":21,"text":"eviduje Státní archeologický seznam (http://isad.npu.cz) osm území s archeologickými","bbox":[70.82,586.546,524.466,598.546],"group_id":"p11-6","quality_score":1.0},{"page":"11","line":22,"text":"nálezy, na katastru Černé Budy území šest.","bbox":[70.824,608.5,278.302,620.5],"group_id":"p11-6","quality_score":1.0},{"page":"11","line":23,"text":"k. ú. Sázava","bbox":[70.824,640.66,133.478,653.62],"group_id":"p11-7","quality_score":1.0,"style":{"bold":true}},{"page":"11","line":24,"text":"Z osmi území ležících na katastru obce Sázava je sedm zařazeno do nejvyšší kategorie","bbox":[106.22,658.66,524.419,670.66],"group_id":"p11-7","quality_score":1.0},{"page":"11","line":25,"text":"ÚAN I., jediné do nižší kategorie ÚAN II. Územím ve druhé kategorii ÚAN jsou Sklárny","bbox":[70.82,680.62,524.346,692.62],"group_id":"p11-7","quality_score":1.0},{"page":"11","line":26,"text":"Kavalier a mlýn Kácek (ID SAS 34902). Prostor zahrnuje areál skláren, který byl založen","bbox":[70.82,702.58,524.571,714.58],"group_id":"p11-7","quality_score":1.0,"style":{"italic":true}},{"page":"11","line":27,"text":"v r. 1837 (huť Prokop) u staršího barokního mlýna Kácek. V areálu později vznikly 3 další hutě","bbox":[70.82,724.564,524.552,736.564],"group_id":"p11-7","quality_score":1.0},{"page":"11","line":28,"text":"(huť František r. 1884, Josef v r. 1902 a Vladimír v r. 1922). Území je vymezeno v rozsahu","bbox":[70.832,746.644,524.497,758.644],"group_id":"p11-7","quality_score":1.0},{"page":"11","line":29,"text":"11","bbox":[292.01,781.92,303.249,792.96],"group_id":"p11-8","quality_score":1.0,"style":{"region":"page_footer"}},{"page":"12","line":0,"text":"objektů a prvků zaznačených na mapách stabilního a pozemkového katastru a přibližně","bbox":[70.824,73.22,524.556,85.22],"group_id":"p12-0","quality_score":1.0},{"page":"12","line":1,"text":"odpovídá současnému rozsahu skláren Kavalier.","bbox":[70.824,95.3,303.336,107.3],"group_id":"p12-0","quality_score":1.0},{"page":"12","line":2,"text":"Uvnitř výše popsaného území historického areálu skláren se nachází i první území","bbox":[106.224,127.22,524.07,139.22],"group_id":"p12-1","quality_score":1.0},{"page":"12","line":3,"text":"zařazené do kategorie ÚAN I. Je jím Huť Prokop – zaniklá sklárna (ID SAS 34915), ležící v trase","bbox":[70.824,149.18,524.705,161.18],"group_id":"p12-1","quality_score":1.0},{"page":"12","line":4,"text":"dnešní ul. Na Kácku, v prostoru mezi objekty huti Josef a huti František. Zde se v minulosti","bbox":[70.824,171.14,524.575,183.14],"group_id":"p12-1","quality_score":1.0},{"page":"12","line":5,"text":"nacházel nejstarší hutní objekt skláren Kavalier. Objekt vznikl v r. 1837, hutní provoz v něm","bbox":[70.824,193.1,524.52,205.1],"group_id":"p12-1","quality_score":1.0},{"page":"12","line":6,"text":"byl ukončen na přelomu 19. a 20. století. Zbořen byl po 2. světové válce.","bbox":[70.836,215.06,422.188,227.06],"group_id":"p12-1","quality_score":1.0},{"page":"12","line":7,"text":"Druhým územím v kategorii ÚAN I je Sázava – ulice Na Křemelce (ID SAS 11685, poř.","bbox":[108.983,247.136,515.652,259.136],"group_id":"p12-2","quality_score":1.0},{"page":"12","line":8,"text":"č. SAS 13-31-24/10), ležící ve východní části obce. Při výkopu jímky zde byl v roce 1970","bbox":[70.848,269.096,524.605,281.096],"group_id":"p12-2","quality_score":1.0},{"page":"12","line":9,"text":"objeven Z. Plechatou žárový hrob doby římské. Byl uložen jen asi 30 cm pod dnešním","bbox":[70.848,291.056,524.147,303.056],"group_id":"p12-2","quality_score":1.0},{"page":"12","line":10,"text":"povrchem, pohřbeno zde bylo asi dvou- až čtyřleté dítě. Později, v roce 1984, v hlíně z","bbox":[70.848,313.016,524.327,325.016],"group_id":"p12-2","quality_score":1.0},{"page":"12","line":11,"text":"výkopu v ulici Na Křemelce a Čihadlo nalezena keramika hradištní, vrcholně–pozdně","bbox":[70.848,334.976,524.592,346.976],"group_id":"p12-2","quality_score":1.0},{"page":"12","line":12,"text":"středověká a rovněž keramika mladší doby římské.","bbox":[70.848,356.936,316.572,368.936],"group_id":"p12-2","quality_score":1.0},{"page":"12","line":13,"text":"Třetí území se nazývá Sázava – jez (ID SAS: 11686 Poř. č. SAS: 13-31-24/11) a leží","bbox":[106.248,389.0,524.618,401.0],"group_id":"p12-3","quality_score":1.0},{"page":"12","line":14,"text":"na levém břehu řeky, naproti sázavskému klášteru. Při pracích na stavbě nového jezu na","bbox":[70.86,410.96,524.429,422.96],"group_id":"p12-3","quality_score":1.0},{"page":"12","line":15,"text":"levém břehu Sázavy zde byly nalezeny železné předměty a keramika 15. – 16. století, bližší","bbox":[70.86,432.908,524.497,444.92],"group_id":"p12-3","quality_score":1.0},{"page":"12","line":16,"text":"nálezové okolnosti nebyly zjištěny.","bbox":[70.834,454.87,239.242,466.87],"group_id":"p12-3","quality_score":1.0},{"page":"12","line":17,"text":"Území čtvrté, Dojetřice/Sázava – hradiště V Šancích, Na Šancích (ID SAS 12055, poř. č.","bbox":[106.222,486.91,524.494,498.91],"group_id":"p12-4","quality_score":1.0},{"page":"12","line":18,"text":"SAS 13-33-04/2), lze nalézt na levém břehu Sázavy, mezi Dojetřicemi a Sázavou. Na ostrožně","bbox":[70.822,508.87,524.554,520.87],"group_id":"p12-4","quality_score":1.0},{"page":"12","line":19,"text":"v poloze Na Šancích zde leží raně středověké hradiště. Opevněný areál se rozkládá na ploše","bbox":[70.834,530.83,524.439,542.83],"group_id":"p12-4","quality_score":1.0},{"page":"12","line":20,"text":"12 ha a je rozdělen středním valem na dvě nestejně velké části. Menší, východní, kterou lze","bbox":[70.834,552.826,524.488,564.826],"group_id":"p12-4","quality_score":1.0},{"page":"12","line":21,"text":"snad označit za akropoli, je dobře chráněna nepřístupným terénem. Hradiště vymezuje vnější","bbox":[70.834,574.786,524.381,586.786],"group_id":"p12-4","quality_score":1.0},{"page":"12","line":22,"text":"val o délce téměř 270 metrů, který dosahuje výšky až 2 metry a šířky 4 až 6 metrů. Na","bbox":[70.834,596.746,524.017,608.746],"group_id":"p12-4","quality_score":1.0},{"page":"12","line":23,"text":"západní straně je z vnější strany ještě patrný příkop. Někdy se uvažuje o souvislosti hradiště","bbox":[70.834,618.706,524.038,630.706],"group_id":"p12-4","quality_score":1.0},{"page":"12","line":24,"text":"s těžbou vápence na asi 1 km vzdáleném vrchu Bílý kámen.","bbox":[70.834,640.666,357.067,652.666],"group_id":"p12-4","quality_score":1.0},{"page":"12","line":25,"text":"Zmíněný vrch Bílý kámen je územím pátým (Sázava – poloha Bílý kámen – lomy, ID","bbox":[106.234,672.706,524.497,684.706],"group_id":"p12-5","quality_score":1.0},{"page":"12","line":26,"text":"SAS 12056, poř. č. SAS 13-33-04/3). Území pokrývá vrch Na Sedlišti (456 m n. m.) na jehož SV","bbox":[70.846,694.666,524.603,706.666],"group_id":"p12-5","quality_score":1.0},{"page":"12","line":27,"text":"straně se nachází vápencový lom, který byl využíván od pravěku do novověku. V letech 1937","bbox":[70.846,716.638,524.09,728.65],"group_id":"p12-5","quality_score":1.0},{"page":"12","line":28,"text":"a 1939 byly K. Žeberou objeveny a zkoumány lomy neolitické. V roce 1970, tehdy již po","bbox":[70.824,738.6,524.029,750.6],"group_id":"p12-5","quality_score":1.0},{"page":"12","line":29,"text":"12","bbox":[292.01,781.92,303.249,792.96],"group_id":"p12-6","quality_score":1.0,"style":{"region":"page_footer"}},{"page":"13","line":0,"text":"ukončení recentní těžby, bylo při zaměření situace zakresleno do plánu 144 jam po těžbě","bbox":[70.824,73.22,524.1,85.22],"group_id":"p13-0","quality_score":1.0},{"page":"13","line":1,"text":"vápence. Drobné i větší mělké jámy při hřebeni náleží těžbě v období neolitu a v době","bbox":[70.824,95.3,524.172,107.3],"group_id":"p13-0","quality_score":1.0},{"page":"13","line":2,"text":"bronzové. Většina byla však zničena nebo překryta při těžební aktivitě od raného středověku","bbox":[70.824,117.26,524.052,129.26],"group_id":"p13-0","quality_score":1.0},{"page":"13","line":3,"text":"do novověku.","bbox":[70.824,139.22,136.807,151.22],"group_id":"p13-0","quality_score":1.0},{"page":"13","line":4,"text":"Šestým územím je Sázava – kostel sv. Martina se hřbitovem (ID SAS 12058, poř. č. SAS","bbox":[106.224,171.14,524.68,183.14],"group_id":"p13-1","quality_score":1.0},{"page":"13","line":5,"text":"13-33-04/5), ležící na pravém břehu Dojetřického potoka v blízkosti jeho vtoku do Sázavy.","bbox":[70.836,193.1,524.542,205.1],"group_id":"p13-1","quality_score":1.0},{"page":"13","line":6,"text":"Kostel sv. Martina je původním farním kostelem osady na levém břehu Sázavy, pochází asi ze","bbox":[70.836,215.06,523.956,227.06],"group_id":"p13-1","quality_score":1.0},{"page":"13","line":7,"text":"14. století (doložen 1402). Zbarokován v 18. století, přestavěn po požáru 1856–1857 a znovu","bbox":[70.836,237.056,524.425,249.056],"group_id":"p13-1","quality_score":1.0},{"page":"13","line":8,"text":"1888. Při hloubení jam u kostela při rušení hřbitova byly porušeny hroby a ve vykopané hlíně","bbox":[70.836,259.136,524.405,271.136],"group_id":"p13-1","quality_score":1.0},{"page":"13","line":9,"text":"byla nalezena keramika pozdně hradištní až novověká.","bbox":[70.836,281.096,335.165,293.096],"group_id":"p13-1","quality_score":1.0},{"page":"13","line":10,"text":"Výše zmíněný kostel se hřbitovem se nachází v těsné blízkosti lokality. Samotná","bbox":[106.236,313.016,524.263,325.016],"group_id":"p13-2","quality_score":1.0},{"page":"13","line":11,"text":"zkoumaná lokalita pak leží přímo v prostoru posledního území zařazeného do kategorie ÚAN","bbox":[70.836,334.976,524.294,346.976],"group_id":"p13-2","quality_score":1.0},{"page":"13","line":12,"text":"I, nazvaného Sázava – poloha V lázních (ID SAS 12057, poř. č. SAS 13-33-04/4). Při stavbě","bbox":[70.836,356.924,524.6,368.936],"group_id":"p13-2","quality_score":1.0},{"page":"13","line":13,"text":"rekreačních chat bývalého podniku RaJ byla ve vykopané tmavé kulturní vrstvě nalezena","bbox":[70.832,378.89,524.676,390.89],"group_id":"p13-2","quality_score":1.0},{"page":"13","line":14,"text":"keramika střední až pozdní doby hradištní a středověká, zčásti na ppč. 452–454, další asi 150","bbox":[70.832,400.994,524.372,412.994],"group_id":"p13-2","quality_score":1.0},{"page":"13","line":15,"text":"metrů východněji, v zahradě u železniční zastávky. V zahradě domu č. p. 352 byl nalezen","bbox":[70.832,422.954,524.604,434.954],"group_id":"p13-2","quality_score":1.0},{"page":"13","line":16,"text":"ojedinělý kostrový hrob. Uvažuje se o souvislosti osídlení s hradištěm „Na Šancích“, ale může","bbox":[70.832,444.914,524.564,456.914],"group_id":"p13-2","quality_score":1.0},{"page":"13","line":17,"text":"jít i o prostor nejstaršího jádra městečka Sázava.","bbox":[70.832,466.874,305.648,478.874],"group_id":"p13-2","quality_score":1.0},{"page":"13","line":18,"text":"k. ú. Černé Budy","bbox":[70.824,499.03,158.561,511.99],"group_id":"p13-3","quality_score":1.0,"style":{"bold":true}},{"page":"13","line":19,"text":"Na katastru Černé Budy eviduje Státní archeologický seznam šest území","bbox":[106.22,517.03,524.484,529.03],"group_id":"p13-3","quality_score":1.0},{"page":"13","line":20,"text":"s archeologickými nálezy, z nichž pět spadá do nejvyšší kategorie území ÚAN I, jedno spadá","bbox":[70.82,539.11,524.15,551.11],"group_id":"p13-3","quality_score":1.0},{"page":"13","line":21,"text":"do kategorie ÚAN II.","bbox":[70.82,561.106,169.198,573.106],"group_id":"p13-3","quality_score":1.0},{"page":"13","line":22,"text":"Nejvýznamnějším územím je Sázava – benediktinský klášter (ID SAS 11691, poř. č. SAS","bbox":[106.22,593.026,524.545,605.026],"group_id":"p13-4","quality_score":1.0},{"page":"13","line":23,"text":"13-31-24/2), jehož historie je popsána výše. Archeologický výzkum zde doložil, že dnešní","bbox":[70.82,614.986,524.41,626.986],"group_id":"p13-4","quality_score":1.0},{"page":"13","line":24,"text":"budovy kláštera stojí nad zbytky starších objektů obvykle stejného účelu. Nejstarší klášter","bbox":[70.82,636.946,524.191,648.946],"group_id":"p13-4","quality_score":1.0},{"page":"13","line":25,"text":"z 11. století byl dřevěný, v jeho jádře stál kostel, jehož podoba není známa. V roce 1095 byla","bbox":[70.82,658.906,524.517,670.906],"group_id":"p13-4","quality_score":1.0},{"page":"13","line":26,"text":"vysvěcena východní část nového kamenného kostela, přestavovaného potom ve 12. století.","bbox":[70.82,680.866,524.215,692.866],"group_id":"p13-4","quality_score":1.0},{"page":"13","line":27,"text":"Uvnitř i vně kostela existovalo od 11. století pohřebiště. V místech starší dřevěné prelatury","bbox":[70.82,702.946,524.029,714.946],"group_id":"p13-4","quality_score":1.0},{"page":"13","line":28,"text":"vznikla ve 12. století mariánská jednolodní kaple.","bbox":[70.82,724.93,309.062,736.93],"group_id":"p13-4","quality_score":1.0},{"page":"13","line":29,"text":"13","bbox":[292.01,781.92,303.249,792.96],"group_id":"p13-5","quality_score":1.0,"style":{"region":"page_footer"}},{"page":"14","line":0,"text":"Další přestavby klášterních budov a kostela následovaly v gotickém období, kostelní","bbox":[106.22,73.22,524.384,85.22],"group_id":"p14-0","quality_score":1.0},{"page":"14","line":1,"text":"chór byl stavěn nad umělou jeskyní, uctívanou jako místo Prokopova poustevnického","bbox":[70.82,95.3,524.139,107.3],"group_id":"p14-0","quality_score":1.0},{"page":"14","line":2,"text":"pobývání. Při těchto přestavbách zanikla mariánská kaple a románská prelatura. Za husitství","bbox":[70.82,117.26,524.062,129.26],"group_id":"p14-0","quality_score":1.0},{"page":"14","line":3,"text":"klášter ztratil svůj majetek a chátral, postupná rekonstrukce započala až ve druhé polovině","bbox":[70.82,139.22,524.216,151.22],"group_id":"p14-0","quality_score":1.0},{"page":"14","line":4,"text":"17. století. Středověký ráz staveb setřela pak zejména přestavba po požáru v roce 1746,","bbox":[70.82,161.18,524.036,173.18],"group_id":"p14-0","quality_score":1.0},{"page":"14","line":5,"text":"v roce 1785 byl klášter zrušen. Budovy kláštera poté sloužily jako zámek.","bbox":[70.82,183.14,422.535,195.14],"group_id":"p14-0","quality_score":1.0},{"page":"14","line":6,"text":"Od začátků kláštera vzniklo v jeho těsném severním sousedství laické sídliště","bbox":[106.22,215.06,524.264,227.06],"group_id":"p14-1","quality_score":1.0},{"page":"14","line":7,"text":"klášterních služebníků, u něhož stála v roce 1070 vysvěcená tetrakonchální kaple sv. Kříže.","bbox":[70.82,237.056,524.203,249.056],"group_id":"p14-1","quality_score":1.0},{"page":"14","line":8,"text":"Na východ, jih a západ od ní existovalo pohřebiště, fungující minimálně do husitských válek,","bbox":[70.82,259.136,523.99,271.136],"group_id":"p14-1","quality_score":1.0},{"page":"14","line":9,"text":"severně od kostela leželo samotné sídliště. V první polovině 13. století zde vznikla velká","bbox":[70.82,281.096,524.172,293.096],"group_id":"p14-1","quality_score":1.0},{"page":"14","line":10,"text":"zemnice, sídlo klášterního nápravníka. Sídliště zaniklo na počátku 14. století. Při klášteře","bbox":[70.832,303.056,524.144,315.056],"group_id":"p14-1","quality_score":1.0},{"page":"14","line":11,"text":"stála řada hospodářských a výrobních objektů, z nichž byla archeologicky doložena","bbox":[70.832,325.016,524.722,337.016],"group_id":"p14-1","quality_score":1.0},{"page":"14","line":12,"text":"bronzolitecká a snad i sklářská dílna. Po odchodu laiků bylo pohřebiště s kostelem obehnáno","bbox":[70.832,346.976,524.103,358.976],"group_id":"p14-1","quality_score":1.0},{"page":"14","line":13,"text":"kamenným opevněním, na místě zemnice vznikl palác s výhřevnou pecí.","bbox":[70.832,368.936,419.386,380.936],"group_id":"p14-1","quality_score":1.0},{"page":"14","line":14,"text":"Rovněž jižně od zámku při sledování inženýrských sítí zjištěny archeologické situace","bbox":[106.232,400.988,524.591,413.0],"group_id":"p14-2","quality_score":1.0},{"page":"14","line":15,"text":"od raného středověku do novověku.","bbox":[70.832,422.95,246.86,434.95],"group_id":"p14-2","quality_score":1.0},{"page":"14","line":16,"text":"Vymezené území představuje areál vlastního kláštera, tzv. severní zahrady a","bbox":[106.232,454.87,524.196,466.87],"group_id":"p14-3","quality_score":1.0},{"page":"14","line":17,"text":"bezprostřední zázemí kláštera. Ke klášteru přiléhá UAN II osady Černé Budy.","bbox":[70.832,476.83,439.91,488.83],"group_id":"p14-3","quality_score":1.0},{"page":"14","line":18,"text":"Druhé území, Černé Budy – mohylník Na Davídkách (Mělník) (ID SAS 11684, poř. č.","bbox":[106.232,508.87,524.624,520.87],"group_id":"p14-4","quality_score":1.0},{"page":"14","line":19,"text":"SAS 13-31-24/1) se nachází na východním okraji lesa Na Davídkách, JJZ od vrchu Strážiště.","bbox":[70.832,530.83,524.768,542.83],"group_id":"p14-4","quality_score":1.0},{"page":"14","line":20,"text":"Dochovalo se zde raně středověké mohylové pohřebiště. Přesný počet mohyl není jasný,","bbox":[70.832,552.826,524.366,564.826],"group_id":"p14-4","quality_score":1.0},{"page":"14","line":21,"text":"většinou se uvádí dochovaných 14 až 17 (11 severně od křižovatky cest, 4 až 5 mezi hlavní","bbox":[70.832,574.786,524.543,586.786],"group_id":"p14-4","quality_score":1.0},{"page":"14","line":22,"text":"cestou ze Sázavy a cestou jdoucí údolím Čertovy brázdy), další jsou někdy zmiňovány","bbox":[70.832,596.746,524.244,608.746],"group_id":"p14-4","quality_score":1.0},{"page":"14","line":23,"text":"roztroušeny na sever od hlavní skupiny. Čtyři mohyly byly prozkoumány I. Borkovským a","bbox":[70.832,618.706,524.099,630.706],"group_id":"p14-4","quality_score":1.0},{"page":"14","line":24,"text":"datovány do 9. století.","bbox":[70.832,640.666,179.597,652.666],"group_id":"p14-4","quality_score":1.0},{"page":"14","line":25,"text":"Třetí území je nazvané Černé Budy – S od sázavského kláštera (ID SAS 11687, poř. č.","bbox":[106.232,672.706,524.636,684.706],"group_id":"p14-5","quality_score":1.0},{"page":"14","line":26,"text":"SAS 13-31-24/12) a leží vně klášterní zahrady. Archeologický výzkum při přestavbě stodoly","bbox":[70.844,694.666,524.392,706.666],"group_id":"p14-5","quality_score":1.0},{"page":"14","line":27,"text":"zde doložil osídlení od vrcholného středověku.","bbox":[70.844,716.65,296.432,728.65],"group_id":"p14-5","quality_score":1.0},{"page":"14","line":28,"text":"14","bbox":[292.01,781.92,303.249,792.96],"group_id":"p14-6","quality_score":1.0,"style":{"region":"page_footer"}},{"page":"15","line":0,"text":"Čtvrtým územím jsou Černé Budy – poloha Krkavčí skály (ID SAS 11688, poř. č. SAS","bbox":[106.22,73.22,524.61,85.22],"group_id":"p15-0","quality_score":1.0},{"page":"15","line":1,"text":"13-31-24/13), ležící na hřebeni na pravém břehu Sázavy. Na úzkém skalním hřebenu Krkavčí","bbox":[70.82,95.3,524.324,107.3],"group_id":"p15-0","quality_score":1.0},{"page":"15","line":2,"text":"skály, mezi údolími řeky Sázavy a Vlkančického potoka, je doloženo osídlení z několika","bbox":[70.82,117.26,524.391,129.26],"group_id":"p15-0","quality_score":1.0},{"page":"15","line":3,"text":"období pravěku a z raného středověku. Dosud se však nepodařilo určit, ve kterém z období","bbox":[70.82,139.22,524.197,151.22],"group_id":"p15-0","quality_score":1.0},{"page":"15","line":4,"text":"došlo k vybudování fortifikace. Hradiště leží na východní části hřebene. Od východu je","bbox":[70.82,161.18,524.229,173.18],"group_id":"p15-0","quality_score":1.0},{"page":"15","line":5,"text":"odděleno mělkým sedlem, na severní straně se sklání do údolí potoka a JV, J a JZ část končí","bbox":[70.82,183.14,524.192,195.14],"group_id":"p15-0","quality_score":1.0},{"page":"15","line":6,"text":"skalami nad řekou. Hradiště bylo chráněno obvodovým valem a před ním vyhloubeným","bbox":[70.82,205.1,524.331,217.1],"group_id":"p15-0","quality_score":1.0},{"page":"15","line":7,"text":"příkopem.","bbox":[70.82,227.06,120.867,239.06],"group_id":"p15-0","quality_score":1.0},{"page":"15","line":8,"text":"Páté území, Mělník – J od polohy V zákoutí (ID SAS 11697, poř. č. SAS 13-31-24/8), leží","bbox":[106.215,259.136,524.589,271.136],"group_id":"p15-1","quality_score":1.0},{"page":"15","line":9,"text":"nad lesem Třešňovka, severně od kóty 458 m. Sběrem zde byla na poli získána keramika","bbox":[70.832,281.096,524.212,293.096],"group_id":"p15-1","quality_score":1.0},{"page":"15","line":10,"text":"z doby hradištní. V literatuře je území chybně vedeno jako k. ú. Mělník.","bbox":[70.832,303.056,415.928,315.056],"group_id":"p15-1","quality_score":1.0},{"page":"15","line":11,"text":"Území poslední, šesté, spadající do kategorie ÚAN II, je Nechyba – novověká ves a","bbox":[106.232,334.976,524.473,346.976],"group_id":"p15-2","quality_score":1.0},{"page":"15","line":12,"text":"zaniklá sklárna (ID SAS 34896, poř. č. SAS –). Ves ležela severně od sázavského kláštera.","bbox":[70.832,356.924,524.51,368.936],"group_id":"p15-2","quality_score":1.0,"style":{"italic":true}},{"page":"15","line":13,"text":"V roce 1708 zde byla, z podnětu opata Košína, avšak bez schválení konventu, založena","bbox":[70.826,378.89,524.151,390.89],"group_id":"p15-2","quality_score":1.0},{"page":"15","line":14,"text":"sklárna sázavského kláštera. Pracovala i po odvolání opata (1712) snad do roku 1715, pak","bbox":[70.826,400.994,523.978,412.994],"group_id":"p15-2","quality_score":1.0},{"page":"15","line":15,"text":"byla v r. 1717 obnovena a definitivně zanikla snad 1719. Její poloha není prozatím","bbox":[70.826,422.954,524.175,434.954],"group_id":"p15-2","quality_score":1.0},{"page":"15","line":16,"text":"lokalizovaná.","bbox":[70.826,444.914,134.017,456.914],"group_id":"p15-2","quality_score":1.0},{"page":"15","line":17,"text":"15","bbox":[292.01,781.92,303.249,792.96],"group_id":"p15-3","quality_score":1.0,"style":{"region":"page_footer"}},{"page":"16","line":0,"text":"Mapa č. 5: Červeně vyznačeno vyznačeno Území s archeologickými nálezy 1 I. kategorie, modře II. kategorie,","bbox":[79.944,423.01,515.226,433.84],"group_id":"p16-0","quality_score":1.0,"style":{"bold":true}},{"page":"16","line":1,"text":"ostatní plochy III. kategorie. Poloha lokality je označena šipkou. Systém SAS (státní archeologický seznam),","bbox":[82.466,437.924,512.715,447.884],"group_id":"p16-1","quality_score":1.0},{"page":"16","line":2,"text":"Národního památkového ústavu. Zdroj: http://isad.npu.cz/tms/arch_public. [15. 10 2020]","bbox":[115.942,451.967,479.306,461.927],"group_id":"p16-2","quality_score":1.0},{"page":"16","line":3,"text":"6 Cíle a metoda výzkumu","bbox":[70.824,490.78,223.734,504.82],"group_id":"p16-3","quality_score":1.0,"style":{"bold":true,"heading_level":3}},{"page":"16","line":4,"text":"V souvislosti s plánovanými zemními pracemi na území obce Sázava, v prostoru, který","bbox":[106.22,515.95,524.497,527.95],"group_id":"p16-4","quality_score":1.0},{"page":"16","line":5,"text":"je součástí ÚAN kategorie I, vznikl oprávněný požadavek na archeologický výzkum ohrožené","bbox":[70.82,537.91,524.312,549.91],"group_id":"p16-5","quality_score":1.0},{"page":"16","line":6,"text":"památky vyplývající ze zákona číslo 20/1987 Sb. (§ 21–24) ve znění zákona č. 425/1990 a","bbox":[70.82,559.906,524.598,571.906],"group_id":"p16-6","quality_score":1.0},{"page":"16","line":7,"text":"zákona č. 242/1992 Sb. o státní památkové péči, dále zákona č. 242/1992 Sb. (novela zákona","bbox":[70.82,581.866,524.09,593.866],"group_id":"p16-7","quality_score":1.0},{"page":"16","line":8,"text":"o státní památkové péči), zákona č. 50/1976 Sb. (tzv. stavební zákon – zejména § 127),","bbox":[70.82,603.826,524.407,615.826],"group_id":"p16-8","quality_score":1.0},{"page":"16","line":9,"text":"1 UAN – území s archeologickými nálezy Prostorové vymezení UAN odráží stav současného poznání území z hlediska archeologie a","bbox":[99.144,645.4,524.294,653.71],"group_id":"p16-9","quality_score":1.0},{"page":"16","line":10,"text":"jsou rozdělena do čtyř kategorií: UAN I – území s pozitivně prokázaným a dále bezpečně předpokládaným výskytem archeologických nálezů;","bbox":[70.819,655.511,524.363,663.551],"group_id":"p16-9","quality_score":1.0},{"page":"16","line":11,"text":"UAN II – území, na němž nebyl doposud pozitivně prokázán výskyt archeologických nálezů ale určité indicie mu nasvědčují:","bbox":[70.819,665.231,524.264,673.271],"group_id":"p16-9","quality_score":1.0},{"page":"16","line":12,"text":"pravděpodobnost výskytu archeologických nálezů je 51–100%; UAN III – území, na kterém ještě nebyl rozpoznán a pozitivně doložen výskyt","bbox":[70.827,675.072,524.541,683.112],"group_id":"p16-9","quality_score":1.0},{"page":"16","line":13,"text":"archeologických nálezů a prozatím tomu nenasvědčují žádné indicie, ale předmětné území mohlo být osídleno nebo jinak využito člověkem,","bbox":[70.827,684.793,524.476,692.833],"group_id":"p16-9","quality_score":1.0},{"page":"16","line":14,"text":"a proto existuje 50% pravděpodobnost výskytu archeologických nálezů. Jde tedy o území celé ČR vyjma UAN I, II a IV;UAN IV – území, kde je","bbox":[70.827,694.513,524.565,702.553],"group_id":"p16-9","quality_score":1.0},{"page":"16","line":15,"text":"nereálná pravděpodobnost výskytu archeologických nálezů – veškerá vytěžená území – lomy, cihelny, pískovny apod.","bbox":[70.827,704.354,450.622,712.394],"group_id":"p16-9","quality_score":1.0},{"page":"16","line":16,"text":"§ 21–24 zákona č. 20/1987Sb. – Na celém zájmovém území v kategoriích UAN I – III je nutno dodržovat ustanovení vyplývající ze","bbox":[99.143,723.931,524.348,731.971],"group_id":"p16-10","quality_score":1.0,"style":{"bold":true}},{"page":"16","line":17,"text":"zákona. To znamená, že je nutné v prostoru UAN I, II i III respektovat § 22 zákona č. 20/1987Sb., o státní památkové péči v platné znění, tj.","bbox":[70.827,733.652,524.435,741.692],"group_id":"p16-10","quality_score":1.0},{"page":"16","line":18,"text":"stavebníci jsou již od přípravy stavby , tj. záměru provádět jakékoli zemní práce, při nichž může být objeven archeologický nález ve smyslu §","bbox":[70.827,743.372,524.456,751.412],"group_id":"p16-10","quality_score":1.0},{"page":"16","line":19,"text":"23, povinni tento záměr oznámit Archeologickému ústavu AV ČR a umožnit jemu nebo organizaci oprávněné k archeologickým výzkumům","bbox":[70.827,753.21,524.496,761.253],"group_id":"p16-10","quality_score":1.0},{"page":"16","line":20,"text":"provést na dotčeném území záchranný archeologický výzkum.","bbox":[70.823,762.93,271.514,770.97],"group_id":"p16-10","quality_score":1.0},{"page":"16","line":21,"text":"16","bbox":[292.01,781.92,303.249,792.96],"group_id":"p16-11","quality_score":1.0,"style":{"region":"page_footer"}},{"page":"17","line":0,"text":"zákona č. 83/1998 Sb. (novela tzv. stavebního zákona) a zákona č. 122/2000 Sb. o ochraně","bbox":[70.824,73.22,524.509,85.22],"group_id":"p17-0","quality_score":1.0},{"page":"17","line":1,"text":"sbírek muzejní povahy.","bbox":[70.824,95.3,182.768,107.3],"group_id":"p17-0","quality_score":1.0},{"page":"17","line":2,"text":"Účelem záchranného archeologického výzkumu byla především dokumentace","bbox":[106.224,127.22,524.255,139.22],"group_id":"p17-1","quality_score":1.0},{"page":"17","line":3,"text":"historických terénů, narušovaných a ohroženým zničením při výkopových pracích.","bbox":[70.824,149.18,468.358,161.18],"group_id":"p17-1","quality_score":1.0},{"page":"17","line":4,"text":"Metodika výzkumu","bbox":[70.824,181.46,174.021,194.42],"group_id":"p17-2","quality_score":1.0,"style":{"bold":true}},{"page":"17","line":5,"text":"Na ploše plánované komunikace byla provedena skrývka ornice, jejíž vrstva měla","bbox":[106.22,199.46,524.438,211.46],"group_id":"p17-2","quality_score":1.0},{"page":"17","line":6,"text":"mocnost až 1 m. Na jižní hraně skryté plochy byl zdokumentován řez (označený jako řez 1),","bbox":[70.82,221.42,524.234,233.42],"group_id":"p17-2","quality_score":1.0},{"page":"17","line":7,"text":"zachycující stratigrafii vrstev nad půdním podložím. Po začištění okrové spraše, jež tvořila","bbox":[70.82,243.416,524.396,255.416],"group_id":"p17-2","quality_score":1.0},{"page":"17","line":8,"text":"v místě půdní horizont, byly v ploše rozpoznány tři zahloubené objekty. Ty byly","bbox":[70.82,265.376,524.654,277.376],"group_id":"p17-2","quality_score":1.0},{"page":"17","line":9,"text":"zdokumentovány po začištění a poté rozděleny na poloviny. Po vybrání výplně první části byl","bbox":[70.82,287.336,524.364,299.336],"group_id":"p17-2","quality_score":1.0},{"page":"17","line":10,"text":"zdokumentován řez. Poté byla výplň dobrána a zdokumentován i negativ objektu. Byla","bbox":[70.82,309.296,524.427,321.296],"group_id":"p17-2","quality_score":1.0},{"page":"17","line":11,"text":"provedena kresebná a fotografická dokumentace.","bbox":[70.82,331.256,313.598,343.256],"group_id":"p17-2","quality_score":1.0},{"page":"17","line":12,"text":"Pro písemný zápis informací byl užit tzv. „formulářový popis“ stratigrafických","bbox":[106.22,363.296,524.133,375.296],"group_id":"p17-3","quality_score":1.0},{"page":"17","line":13,"text":"jednotek, a to dle dokumentačních standardů platných ve společnosti Pueblo - archeologická","bbox":[70.82,385.256,524.422,397.256],"group_id":"p17-3","quality_score":1.0},{"page":"17","line":14,"text":"společnost, o. p. s. Konkrétně byl v terénu pro každou stratigrafickou jednotku vypsán","bbox":[70.82,407.24,524.403,419.24],"group_id":"p17-3","quality_score":1.0},{"page":"17","line":15,"text":"patřičný formulář.","bbox":[70.82,429.2,159.188,441.2],"group_id":"p17-3","quality_score":1.0},{"page":"17","line":16,"text":"Movité nálezy byly tříděny v terénu a převezeny k laboratornímu zpracování.","bbox":[106.22,461.12,479.56,473.12],"group_id":"p17-4","quality_score":1.0},{"page":"17","line":17,"text":"Po skončení terénních prací byla provedena digitalizace dokumentace a vytvořeny","bbox":[106.22,493.16,524.12,505.16],"group_id":"p17-5","quality_score":1.0},{"page":"17","line":18,"text":"dílčí plány objektů. Dále byla zpracovávána evidence nálezů, celkový plán výzkumu a také","bbox":[70.82,515.12,524.454,527.12],"group_id":"p17-5","quality_score":1.0},{"page":"17","line":19,"text":"terénní dokumentace, jež je propojena souhrnnou databází (viz přílohy). Terénní výzkum je","bbox":[70.82,537.08,524.059,549.08],"group_id":"p17-5","quality_score":1.0},{"page":"17","line":20,"text":"ukončen touto nálezovou zprávou.","bbox":[70.82,559.076,239.497,571.076],"group_id":"p17-5","quality_score":1.0},{"page":"17","line":21,"text":"7 Popis terénní situace","bbox":[70.824,605.53,210.296,619.57],"group_id":"p17-6","quality_score":1.0,"style":{"bold":true,"heading_level":3}},{"page":"17","line":22,"text":"Řez 1","bbox":[70.824,630.46,94.923,641.5],"group_id":"p17-7","quality_score":1.0,"style":{"bold":true}},{"page":"17","line":23,"text":"Řez 1 dokumentoval stratigrafii vrstev odstraněných skrývkou. Byl vymezen na jižní","bbox":[106.22,656.14,524.455,668.14],"group_id":"p17-7","quality_score":1.0},{"page":"17","line":24,"text":"hraně skryté plochy, zhruba uprostřed parcely č. 1297/1.","bbox":[70.82,678.1,346.686,690.1],"group_id":"p17-7","quality_score":1.0},{"page":"17","line":25,"text":"Mocnost souvrství zachyceného na řezu 1 činí zhruba 1 m. Nejníže byla zachycena","bbox":[106.22,710.02,524.448,722.02],"group_id":"p17-8","quality_score":1.0},{"page":"17","line":26,"text":"okrová spraš, tvořící v místě půdní podloží (vr. 100). Nad okrovou spraší ležela tmavě hnědá","bbox":[70.82,732.124,524.559,744.124],"group_id":"p17-8","quality_score":1.0},{"page":"17","line":27,"text":"písčitá hlína bez příměsí (vr. 105) obsahující množství keramických zlomků (viz níže),","bbox":[70.832,754.084,524.535,766.084],"group_id":"p17-8","quality_score":1.0},{"page":"17","line":28,"text":"17","bbox":[292.01,781.92,303.249,792.96],"group_id":"p17-9","quality_score":1.0,"style":{"region":"page_footer"}},{"page":"18","line":0,"text":"následovaná světle šedohnědou písčitou hlínou bez příměsí (vr. 106). Souvrství je ukončeno","bbox":[70.824,73.22,524.424,85.22],"group_id":"p18-0","quality_score":1.0},{"page":"18","line":1,"text":"tmavě hnědým hlinitopísčitým travním drnem, tvořícím současný povrch (vr. 107).","bbox":[70.836,95.3,470.821,107.3],"group_id":"p18-0","quality_score":1.0},{"page":"18","line":2,"text":"Objekt 500","bbox":[70.824,126.98,120.915,138.02],"group_id":"p18-1","quality_score":1.0,"style":{"bold":true}},{"page":"18","line":3,"text":"Zahloubený objekt označený jako obj. 500 byl zachycen mírně na západ od středu","bbox":[106.22,152.66,524.396,164.66],"group_id":"p18-1","quality_score":1.0},{"page":"18","line":4,"text":"parcely 1297/1. Objekt měl zhruba oválný tvar s delší osou orientovanou ve směru SZ–JV,","bbox":[70.82,174.62,524.72,186.62],"group_id":"p18-1","quality_score":1.0},{"page":"18","line":5,"text":"šikmé stěny a ploché dno. Rozměry objektu činily zhruba 1,2 × 0,85 m, hloubka 0,4 m.","bbox":[70.82,196.58,487.702,208.58],"group_id":"p18-1","quality_score":1.0},{"page":"18","line":6,"text":"Objekt 500 byl vyplněn hnědou písčitou hlínou bez příměsí (vr. 101), která obsahovala","bbox":[106.208,228.656,524.668,240.656],"group_id":"p18-2","quality_score":1.0},{"page":"18","line":7,"text":"zlomky keramiky (viz níže).","bbox":[70.82,250.616,200.852,262.616],"group_id":"p18-2","quality_score":1.0},{"page":"18","line":8,"text":"Objekt 501","bbox":[70.824,282.29,120.915,293.33],"group_id":"p18-3","quality_score":1.0,"style":{"bold":true}},{"page":"18","line":9,"text":"Zahloubený objekt označený jako obj. 501 ležel asi 4 m západně od výše popsaného","bbox":[106.22,307.97,524.374,319.97],"group_id":"p18-3","quality_score":1.0},{"page":"18","line":10,"text":"obj. 500. Objekt měl přibližně kruhový tvar o průměru cca 1 m, šikmé stěny a ploché dno.","bbox":[70.82,329.93,524.391,341.93],"group_id":"p18-3","quality_score":1.0},{"page":"18","line":11,"text":"Hloubka objektu činila 0,2 m.","bbox":[70.82,351.89,212.59,363.89],"group_id":"p18-3","quality_score":1.0},{"page":"18","line":12,"text":"Objekt 501 vyplňovala opět hnědá písčitá hlína bez příměsí (vr. 102), a bohužel i","bbox":[106.22,383.93,524.658,395.93],"group_id":"p18-4","quality_score":1.0},{"page":"18","line":13,"text":"nálezů.","bbox":[70.832,405.914,105.74,417.914],"group_id":"p18-4","quality_score":1.0},{"page":"18","line":14,"text":"Objekt 502","bbox":[70.824,437.59,120.915,448.63],"group_id":"p18-5","quality_score":1.0,"style":{"bold":true}},{"page":"18","line":15,"text":"Objekt 502 byl v průběhu exkavace vyhodnocen jako důsledek porušení podloží","bbox":[106.22,463.27,524.558,475.27],"group_id":"p18-5","quality_score":1.0},{"page":"18","line":16,"text":"živočichy (nora) a netřeba ho blíže popisovat.","bbox":[70.832,485.35,291.326,497.35],"group_id":"p18-5","quality_score":1.0},{"page":"18","line":17,"text":"Objekt 503","bbox":[70.824,517.03,120.915,528.07],"group_id":"p18-6","quality_score":1.0,"style":{"bold":true}},{"page":"18","line":18,"text":"Zahloubený objekt označený jako obj. 503 ležel ze všech zkoumaných nejzápadněji,","bbox":[106.22,542.71,524.17,554.71],"group_id":"p18-6","quality_score":1.0},{"page":"18","line":19,"text":"asi 8 m na Z od obj. 501. Objekt měl zhruba oválný tvar s delší osou orientovanou ve směru","bbox":[70.832,564.706,524.444,576.706],"group_id":"p18-6","quality_score":1.0},{"page":"18","line":20,"text":"SV–JZ, šikmé stěny a ploché dno. Byl ze všech zde prozkoumaných objektů nejrozměrnější –","bbox":[70.832,586.666,524.486,598.666],"group_id":"p18-6","quality_score":1.0},{"page":"18","line":21,"text":"jeho délka činí téměř 3 m, šířka 1,6 m a hloubka 0,5 m.","bbox":[70.832,608.626,336.728,620.626],"group_id":"p18-6","quality_score":1.0},{"page":"18","line":22,"text":"Objekt 503 byl vyplněn tmavě hnědou písčitou hlínou bez příměsí (vr. 104), obsahující","bbox":[106.232,640.666,524.694,652.666],"group_id":"p18-7","quality_score":1.0},{"page":"18","line":23,"text":"však enormní množství zlomků keramiky a zvířecí kosti (viz níže).","bbox":[70.844,662.626,384.654,674.626],"group_id":"p18-7","quality_score":1.0},{"page":"18","line":24,"text":"Movité nálezy","bbox":[70.824,694.3,135.34,705.34],"group_id":"p18-8","quality_score":1.0,"style":{"bold":true}},{"page":"18","line":25,"text":"Při začišťování a vzorkování vrstvy 105 na řezu 1 bylo získáno celkem 8 zlomků","bbox":[106.22,720.0,524.48,732.0],"group_id":"p18-8","quality_score":1.0},{"page":"18","line":26,"text":"keramických nádob (pět zlomků těla nádoby, po jednom zlomku okraje, ucha a dna). Jedná","bbox":[70.82,741.96,524.661,753.96],"group_id":"p18-8","quality_score":1.0},{"page":"18","line":27,"text":"18","bbox":[292.01,781.92,303.249,792.96],"group_id":"p18-9","quality_score":1.0,"style":{"region":"page_footer"}},{"page":"19","line":0,"text":"se o drobné a omleté zlomky běžné kuchyňské a stolní keramiky. Soubor má velmi široké","bbox":[70.824,73.22,524.362,85.22],"group_id":"p19-0","quality_score":1.0},{"page":"19","line":1,"text":"chronologické rozpětí – dva nejstarší zlomky pochází již patrně z pravěku; zbytek vznikal ve","bbox":[70.824,95.3,524.5,107.3],"group_id":"p19-0","quality_score":1.0},{"page":"19","line":2,"text":"vrcholném/pozdním středověku až novověku (viz přílohu 3, tab. 1; i. č. 459/18/1).","bbox":[70.824,117.26,467.581,129.26],"group_id":"p19-0","quality_score":1.0},{"page":"19","line":3,"text":"Z vrstvy 101, která vyplňovala objekt 500, bylo při exkavaci získáno 6 zlomků","bbox":[106.224,149.18,524.22,161.18],"group_id":"p19-1","quality_score":1.0},{"page":"19","line":4,"text":"keramických nádob. Soubor je homogenní, zlomky jsou páleny do odstínů šedé až","bbox":[70.824,171.14,524.15,183.14],"group_id":"p19-1","quality_score":1.0},{"page":"19","line":5,"text":"červenohnědé, ostřené rozemletým svorem, v některých případech zdobené hřebenovou","bbox":[70.824,193.1,524.296,205.1],"group_id":"p19-1","quality_score":1.0},{"page":"19","line":6,"text":"vlnicí. Soubor lze datovat do raného středověku, středohradištního období (viz přílohu 3, tab.","bbox":[70.824,215.06,524.674,227.06],"group_id":"p19-1","quality_score":1.0},{"page":"19","line":7,"text":"2; i. č. 459/18/2).","bbox":[70.824,237.056,154.612,249.056],"group_id":"p19-1","quality_score":1.0},{"page":"19","line":8,"text":"Zdaleka největší soubor pak pochází z vrstvy 104, výplně objektu 503. Při exkavaci","bbox":[106.224,269.096,524.479,281.096],"group_id":"p19-2","quality_score":1.0},{"page":"19","line":9,"text":"bylo získáno 84 zlomků těla nádoby, 25 zlomků okraje, 18 zlomků dna a 7 zlomků, z nichž se","bbox":[70.824,291.056,524.568,303.056],"group_id":"p19-2","quality_score":1.0},{"page":"19","line":10,"text":"při zpracování podařilo slepit větší části tří nádob, dohromady tedy plných 134 keramických","bbox":[70.824,313.016,524.542,325.016],"group_id":"p19-2","quality_score":1.0},{"page":"19","line":11,"text":"zlomků. Materiál zlomků odpovídá výše popsaným nálezům z obj. 500 – keramické těsto je","bbox":[70.824,334.976,524.632,346.976],"group_id":"p19-2","quality_score":1.0},{"page":"19","line":12,"text":"typicky ostřeno slídou a drceným svorem, páleno je do odstínů od šedé před okrovou a","bbox":[70.824,356.936,524.503,368.936],"group_id":"p19-2","quality_score":1.0},{"page":"19","line":13,"text":"hnědou až k červenohnědé. Zlomky jsou často bohatě zdobené, a to hřebenovou (řidčeji","bbox":[70.812,378.884,524.597,390.896],"group_id":"p19-2","quality_score":1.0},{"page":"19","line":14,"text":"prostou) vlnicí či vodorovným hřebenováním. Nejčetnější výzdobu však představuje","bbox":[70.822,400.994,524.272,412.994],"group_id":"p19-2","quality_score":1.0},{"page":"19","line":15,"text":"protisměrný hřebenový vpich, a to v několika řadách, případně v kombinaci s vlnicí. Rozložení","bbox":[70.834,422.954,524.531,434.954],"group_id":"p19-2","quality_score":1.0},{"page":"19","line":16,"text":"výzdoby se na nádobách vyskytuje na horní i ve střední části těla. Okraje nádob jsou vně","bbox":[70.846,444.914,524.614,456.914],"group_id":"p19-2","quality_score":1.0},{"page":"19","line":17,"text":"vyhnuté. Nádoby jsou obtáčené na kruhu. Stejně jako výše popsaný soubor z objektu 500 lze","bbox":[70.858,466.874,524.521,478.874],"group_id":"p19-2","quality_score":1.0},{"page":"19","line":18,"text":"i tento datovat do raného středověku, středohradištního období (viz přílohu 3, tab. 3–10; i. č.","bbox":[70.858,488.834,524.662,500.834],"group_id":"p19-2","quality_score":1.0},{"page":"19","line":19,"text":"459/18/3–9). Soubor keramiky z objektu 503 doplňují tři blíže neurčené zvířecí kosti (i. č.","bbox":[70.87,510.794,524.35,522.794],"group_id":"p19-2","quality_score":1.0},{"page":"19","line":20,"text":"459/18/10).","bbox":[70.87,532.754,129.396,544.754],"group_id":"p19-2","quality_score":1.0},{"page":"19","line":21,"text":"8","bbox":[70.824,579.25,77.942,593.29],"group_id":"p19-3","quality_score":1.0,"style":{"bold":true,"heading_level":3}},{"page":"19","line":22,"text":"Zhodnocení výsledků výzkumu a závěr","bbox":[106.267,579.25,328.205,593.29],"group_id":"p19-3","quality_score":1.0,"style":{"bold":true,"heading_level":3}},{"page":"19","line":23,"text":"Záchranný archeologický výzkum vyvolaný plánovanou výstavbou komunikace a","bbox":[106.22,604.42,524.272,616.42],"group_id":"p19-4","quality_score":1.0},{"page":"19","line":24,"text":"inženýrských sítí pro rodinné domky v místě bývalého rekreačního objektu RaJ ve městě","bbox":[70.82,626.38,524.516,638.38],"group_id":"p19-4","quality_score":1.0},{"page":"19","line":25,"text":"Sázava, západně od ul. Pod Zastávkou, přinesl doklady přítomnosti archeologických situací.","bbox":[70.82,648.34,524.596,660.34],"group_id":"p19-4","quality_score":1.0},{"page":"19","line":26,"text":"Ve střední části parcely č. 1297/1 byly odkryty tři zahloubené objekty. Výplně dvou z nich","bbox":[70.832,670.3,524.514,682.3],"group_id":"p19-4","quality_score":1.0},{"page":"19","line":27,"text":"obsahovaly množství keramiky datovatelné do raného středověku, středohradištního období,","bbox":[70.832,692.26,524.62,704.26],"group_id":"p19-4","quality_score":1.0},{"page":"19","line":28,"text":"které lze v absolutních datech vymezit zhruba rozmezím mezi lety 800 a 950 našeho","bbox":[70.832,714.244,524.742,726.244],"group_id":"p19-4","quality_score":1.0},{"page":"19","line":29,"text":"letopočtu.","bbox":[70.832,736.324,121.129,748.324],"group_id":"p19-4","quality_score":1.0},{"page":"19","line":30,"text":"19","bbox":[292.01,781.92,303.249,792.96],"group_id":"p19-5","quality_score":1.0,"style":{"region":"page_footer"}},{"page":"20","line":0,"text":"Výzkum se uskutečnil na území, na němž jsou již známy nálezy z minulosti – jedná se","bbox":[106.22,73.22,524.478,85.22],"group_id":"p20-0","quality_score":1.0},{"page":"20","line":1,"text":"o území „V lázních“ (viz výše – Lokalita ve Státním archeologickém seznamu). Přímo","bbox":[70.82,95.3,524.55,107.3],"group_id":"p20-0","quality_score":1.0},{"page":"20","line":2,"text":"v prostoru rekreačního objektu RaJ, při hloubení výkopů pro betonové základy dřevěných","bbox":[70.82,117.26,524.086,129.26],"group_id":"p20-0","quality_score":1.0},{"page":"20","line":3,"text":"chatek, získal sázavský historik a amatérský archeolog J. Maštalíř soubor keramických","bbox":[70.82,139.22,524.493,151.22],"group_id":"p20-0","quality_score":1.0},{"page":"20","line":4,"text":"zlomků, který později publikoval J. Bubeník (1970). Bubeník zlomky datoval do mladě až","bbox":[70.82,161.18,524.527,173.18],"group_id":"p20-0","quality_score":1.0},{"page":"20","line":5,"text":"pozdně hradištního období (v absolutních datech přibližně r. 950–1200) až","bbox":[70.82,183.14,524.511,195.14],"group_id":"p20-0","quality_score":1.0},{"page":"20","line":6,"text":"pozdněhradištního období (r. 1200–1250) či středověku. Datace byla patrně později","bbox":[70.82,205.1,524.44,217.1],"group_id":"p20-0","quality_score":1.0},{"page":"20","line":7,"text":"revidována, jak je patrné v záznamu SAS (viz výše), popisující výše zmíněnou keramiku jako","bbox":[70.82,227.06,524.491,239.06],"group_id":"p20-0","quality_score":1.0},{"page":"20","line":8,"text":"středně- až pozdněhradištní.","bbox":[70.82,249.056,209.906,261.056],"group_id":"p20-0","quality_score":1.0},{"page":"20","line":9,"text":"Jak již bylo uvedeno výše, nálezový soubor z našeho záchranného arch. výzkumu","bbox":[106.22,281.096,524.385,293.096],"group_id":"p20-1","quality_score":1.0},{"page":"20","line":10,"text":"reprezentuje keramický materiál. Pro chronologicky citlivější rozlišení nálezů se nabízí","bbox":[70.82,303.056,524.326,315.056],"group_id":"p20-1","quality_score":1.0},{"page":"20","line":11,"text":"srovnání s nálezovým souborem z hradiště Stará Kouřim, jehož existence se kryje s téměř","bbox":[70.82,325.016,524.593,337.016],"group_id":"p20-1","quality_score":1.0},{"page":"20","line":12,"text":"celým středohradištním obdobím a keramický materiál byl konfrontován s dalšími","bbox":[70.82,346.976,524.51,358.976],"group_id":"p20-1","quality_score":1.0},{"page":"20","line":13,"text":"chronologicky citlivými nálezy, pocházející především z hrobových souborů.","bbox":[70.82,368.936,437.3,380.936],"group_id":"p20-1","quality_score":1.0},{"page":"20","line":14,"text":"M Šolle (1966, 218–227) rozlišil nálezový soubor na starší horizont A (A1 800–860 n.","bbox":[106.22,401.0,524.636,413.0],"group_id":"p20-2","quality_score":1.0},{"page":"20","line":15,"text":"l., A2, A3 850/860–900 n. l.) a mladší horizont B (B1, B2 900–936/950 n. l.).","bbox":[70.832,422.96,434.942,434.96],"group_id":"p20-2","quality_score":1.0},{"page":"20","line":16,"text":"Pro horizont A je charakteristický červenohnědý výpal, hrnčířské těsto obsahuje","bbox":[106.232,454.88,524.518,466.88],"group_id":"p20-3","quality_score":1.0},{"page":"20","line":17,"text":"značnou příměs slídy. Ve výzdobě se vyskytují nad sebou řazený protisměrný hřebenový","bbox":[70.856,476.828,524.597,488.84],"group_id":"p20-3","quality_score":1.0},{"page":"20","line":18,"text":"vpich a mnohonásobná vlnice v kombinaci s horizontální hřebenovou rýhou. Pozornost je","bbox":[70.836,498.79,524.572,510.79],"group_id":"p20-3","quality_score":1.0},{"page":"20","line":19,"text":"věnována profilaci okrajů pomocí obtáčení, což se projevuje výraznější rýžkou na seříznutém","bbox":[70.836,520.75,524.46,532.75],"group_id":"p20-3","quality_score":1.0},{"page":"20","line":20,"text":"okraji nebo ostřejší profilací. Ve stupni A3 se setkáváme i s prvky plastické profilace okrajů.","bbox":[70.848,542.83,524.508,554.83],"group_id":"p20-3","quality_score":1.0},{"page":"20","line":21,"text":"Vedle této formy se uplatňuje i profil vyhnutý a zaoblený v duchu starších tradic, avšak","bbox":[70.848,564.826,524.501,576.826],"group_id":"p20-3","quality_score":1.0},{"page":"20","line":22,"text":"v preciznějším provedení. O ceně výrobků svědčí i doklady o jejich reparaci. Časté jsou nálezy","bbox":[70.848,586.786,524.111,598.786],"group_id":"p20-3","quality_score":1.0},{"page":"20","line":23,"text":"navrtaných dvojic otvorů podél praskliny. Hrnčířské značky na dně nádob se ve starším","bbox":[70.86,608.746,524.377,620.746],"group_id":"p20-3","quality_score":1.0},{"page":"20","line":24,"text":"horizontu nevyskytují (Šolle 1966, 121–123).","bbox":[70.86,630.706,287.16,642.706],"group_id":"p20-3","quality_score":1.0},{"page":"20","line":25,"text":"Pro mladší horizont B je poměrně charakteristická výzdoba jednoduchou vlnicí","bbox":[106.26,662.626,524.402,674.626],"group_id":"p20-4","quality_score":1.0},{"page":"20","line":26,"text":"umístěnou v horní části nádoby (v podhrdlí). Dále se masivně vyskytuje výzdoba osnovou","bbox":[70.872,684.586,524.687,696.586],"group_id":"p20-4","quality_score":1.0},{"page":"20","line":27,"text":"obvodových rýh na těle nádoby. V mladším horizontu sledujeme pokles uplatnění","bbox":[70.872,706.666,524.611,718.666],"group_id":"p20-4","quality_score":1.0},{"page":"20","line":28,"text":"protisměrného hřebenového vpichu nad sebou. Příznačným rysem (s náznaky už od období","bbox":[70.872,728.65,524.518,740.65],"group_id":"p20-4","quality_score":1.0},{"page":"20","line":29,"text":"A3) je plastické zvýraznění mírně kuželovitého a výrazně odděleného podhrdlí. V nejmladší","bbox":[70.872,750.61,524.2,762.61],"group_id":"p20-4","quality_score":1.0},{"page":"20","line":30,"text":"20","bbox":[292.01,781.92,303.249,792.96],"group_id":"p20-5","quality_score":1.0,"style":{"region":"page_footer"}},{"page":"21","line":0,"text":"fázi (B2) se setkáváme s výskytem hrnčířských značek umístěných na dně nádoby (Šolle 1966,","bbox":[70.824,73.22,524.461,85.22],"group_id":"p21-0","quality_score":1.0},{"page":"21","line":1,"text":"195).","bbox":[70.824,95.3,95.774,107.3],"group_id":"p21-0","quality_score":1.0},{"page":"21","line":2,"text":"Výše uvedený popis staršího horizontu A se vcelku shoduje s naším nálezovým","bbox":[106.224,127.22,524.587,139.22],"group_id":"p21-1","quality_score":1.0},{"page":"21","line":3,"text":"souborem. V příloze č. 2 (obr. č. 15 a 16) jsou vyobrazené příklady výše uvedených horizontů","bbox":[70.824,149.18,524.328,161.18],"group_id":"p21-1","quality_score":1.0},{"page":"21","line":4,"text":"A a B (Šolle 1966, 125 a 197). Vybrané příklady z našeho keramického souboru jsou uvedeny","bbox":[70.836,171.14,524.4,183.14],"group_id":"p21-1","quality_score":1.0},{"page":"21","line":5,"text":"v příloze č. 3 – Dokumentace nálezů. Náš nálezový soubor v konfrontaci mladším horizontem","bbox":[70.836,193.1,524.662,205.1],"group_id":"p21-1","quality_score":1.0},{"page":"21","line":6,"text":"B zcela postrádá výzdobný prvek rýhováním a jednoduchou vlnicí. Co do procenta výskytu je","bbox":[70.836,215.06,524.437,227.06],"group_id":"p21-1","quality_score":1.0},{"page":"21","line":7,"text":"nejčetněji zastoupena výzdoba protisměrným hřebenovým vpichem a hřebenovou vlnicí, což","bbox":[70.836,237.056,524.61,249.056],"group_id":"p21-1","quality_score":1.0},{"page":"21","line":8,"text":"je zcela opačný trend, než u horizontu B. Úpravy okrajů nádob jsou v našem souboru","bbox":[70.836,259.136,524.557,271.136],"group_id":"p21-1","quality_score":1.0},{"page":"21","line":9,"text":"nejčetněji zastoupeny profily vyhnuté (i. č. 459/18/9) a zaoblené (i. č. 459/18/8). Setkáváme","bbox":[70.836,281.096,524.704,293.096],"group_id":"p21-1","quality_score":1.0},{"page":"21","line":10,"text":"se i s plastickým oddělením podhrdlí od okraje nádoby (i. č. 459/18/6), tento trend M. Šolle","bbox":[70.836,303.056,524.65,315.056],"group_id":"p21-1","quality_score":1.0},{"page":"21","line":11,"text":"klade již do závěru horizontu A (A3) s výrazným nárůstem četnosti v mladším období B.","bbox":[70.836,325.016,524.492,337.016],"group_id":"p21-1","quality_score":1.0},{"page":"21","line":12,"text":"V nalezených dnech (celkem 18 ks) se hrnčířské značky nevyskytují. U dvou keramických","bbox":[70.848,346.976,524.543,358.976],"group_id":"p21-1","quality_score":1.0},{"page":"21","line":13,"text":"zlomků můžeme sledovat stopy po reparaci poškozených nádob (i. č. 459/18/4) a (i. č.","bbox":[70.848,368.936,524.52,380.936],"group_id":"p21-1","quality_score":1.0},{"page":"21","line":14,"text":"459/18/8).","bbox":[70.848,390.92,123.28,402.92],"group_id":"p21-1","quality_score":1.0},{"page":"21","line":15,"text":"Na základě porovnání výše uvedených charakteristických znaků nádob klademe","bbox":[106.248,422.96,524.333,434.96],"group_id":"p21-2","quality_score":1.0},{"page":"21","line":16,"text":"získaný soubor do horizontu A3, který M. Šolle datuje cca do třetí třetiny 9. století.","bbox":[70.86,444.908,471.818,456.92],"group_id":"p21-2","quality_score":1.0},{"page":"21","line":17,"text":"Absolutní datace je zde důležitá pro bližší určení sídelních vztahů. J. Bubeník se","bbox":[106.224,476.828,524.604,488.83],"group_id":"p21-3","quality_score":1.0},{"page":"21","line":18,"text":"v interpretaci přiklání k názoru, že zachycené osídlení představuje nejstarší jádro městečka","bbox":[70.834,498.79,524.322,510.79],"group_id":"p21-3","quality_score":1.0},{"page":"21","line":19,"text":"Sázavy. Obecně se však předpokládá, že osada Sázava vznikla až po založení sázavského","bbox":[70.834,520.75,524.193,532.75],"group_id":"p21-3","quality_score":1.0},{"page":"21","line":20,"text":"kláštera, k čemuž nedošlo dříve, než po roce 1000, literatura zmiňuje konkrétně rok 1032","bbox":[70.834,542.83,524.384,554.83],"group_id":"p21-3","quality_score":1.0},{"page":"21","line":21,"text":"(Lutovský 2001, 124). Nadto nelze vyloučit, že ke vzniku osady došlo až po etablování","bbox":[70.834,564.826,524.518,576.826],"group_id":"p21-3","quality_score":1.0},{"page":"21","line":22,"text":"kláštera, tedy s jistým zpožděním.","bbox":[70.846,586.786,235.232,598.786],"group_id":"p21-3","quality_score":1.0},{"page":"21","line":23,"text":"Výzkumem doložené osídlení, jež dle datace přítomné keramiky existovalo již v době","bbox":[106.246,618.706,524.59,630.706],"group_id":"p21-4","quality_score":1.0},{"page":"21","line":24,"text":"středohradištní, vznik kláštera jednoznačně předchází. Stabilní osídlení – jak lze soudit podle","bbox":[70.846,640.666,524.352,652.666],"group_id":"p21-4","quality_score":1.0},{"page":"21","line":25,"text":"značného množství nalezených zlomků, nadto v sídlištních jamách – muselo na lokalitě","bbox":[70.846,662.626,524.53,674.626],"group_id":"p21-4","quality_score":1.0},{"page":"21","line":26,"text":"existovat již dříve.","bbox":[70.846,684.586,158.619,696.586],"group_id":"p21-4","quality_score":1.0},{"page":"21","line":27,"text":"Na základě popsaných zjištění lze tedy pozornost obrátit (doslova) opačným směrem,","bbox":[106.246,716.65,524.658,728.65],"group_id":"p21-5","quality_score":1.0},{"page":"21","line":28,"text":"než leží klášter, a to k hradišti Dojetřice. Toto ostrožné hradiště, ležící nad řekou v poloze „Na","bbox":[70.846,738.61,524.694,750.61],"group_id":"p21-5","quality_score":1.0},{"page":"21","line":29,"text":"21","bbox":[292.01,781.92,303.249,792.96],"group_id":"p21-6","quality_score":1.0,"style":{"region":"page_footer"}},{"page":"22","line":0,"text":"Šancích“, bylo doposud zkoumáno pouze nedestruktivními metodami. Podle nálezů","bbox":[70.824,73.22,524.664,85.22],"group_id":"p22-0","quality_score":1.0},{"page":"22","line":1,"text":"získaných sběrem – keramiky a v Čechách ojedinělého avarsko-slovanského kování","bbox":[70.836,95.3,524.73,107.3],"group_id":"p22-0","quality_score":1.0},{"page":"22","line":2,"text":"vrtulového tvaru – je osídlení hradiště kladeno do konce 8. a 9. století (Lutovský 2001, 292).","bbox":[70.836,117.26,524.489,129.26],"group_id":"p22-0","quality_score":1.0},{"page":"22","line":3,"text":"Jeho původ může být již pravěký (srov. Lutovský 2009 a keramické zlomky získané z vr. 105","bbox":[70.836,139.22,524.599,151.22],"group_id":"p22-0","quality_score":1.0},{"page":"22","line":4,"text":"na řezu 1) 2 . Průzkum pramenů budí dojem, že se jedná o lokalitu ležící spíše stranou zájmu.","bbox":[70.836,160.19,524.157,173.18],"group_id":"p22-0","quality_score":1.0},{"page":"22","line":5,"text":"Je nicméně dostupný digitální model terénu, který jasně ukazuje vstupy (přerušení opevnění)","bbox":[70.82,183.14,524.529,195.14],"group_id":"p22-0","quality_score":1.0},{"page":"22","line":6,"text":"směrem k lokalitě popisované touto zprávou. Lze tedy vyslovit, že doložené osídlení patřilo","bbox":[70.82,205.1,524.336,217.1],"group_id":"p22-0","quality_score":1.0},{"page":"22","line":7,"text":"„podhradí“, či „předhradí“ hradiště Dojetřice. V nižší poloze se mohla soustředit činnost, pro","bbox":[70.832,227.06,524.547,239.06],"group_id":"p22-0","quality_score":1.0},{"page":"22","line":8,"text":"kterou byla rovinatá niva v blízkosti vodního toku vhodnější nežli na kopci umístěné hradiště.","bbox":[70.844,249.056,522.74,261.056],"group_id":"p22-0","quality_score":1.0},{"page":"22","line":9,"text":"I když byl záchranný archeologický výzkum proveden, nelze odhlédnout od","bbox":[106.232,281.096,524.082,293.096],"group_id":"p22-1","quality_score":1.0},{"page":"22","line":10,"text":"skutečnosti, že byl prozkoumán pouze prostor bezprostředně ohrožený stavbou. S velkou","bbox":[70.832,303.056,524.492,315.056],"group_id":"p22-1","quality_score":1.0},{"page":"22","line":11,"text":"mírou pravděpodobnosti můžeme konstatovat, že v okolí plochy výzkumu mohou být","bbox":[70.832,325.016,524.28,337.016],"group_id":"p22-1","quality_score":1.0},{"page":"22","line":12,"text":"zachovány archeologické situace, které jsou pouze konzervovány vrstvou novověkých úprav.","bbox":[70.832,346.976,524.196,358.976],"group_id":"p22-1","quality_score":1.0},{"page":"22","line":13,"text":"V případě dalších zásahů do terénu je potřeba opět počítat se záchranným archeologickým","bbox":[70.832,368.936,524.16,380.936],"group_id":"p22-1","quality_score":1.0},{"page":"22","line":14,"text":"výzkumem vyplývajícím z výše uvedených zákonů o ochraně kulturního dědictví.","bbox":[70.832,390.92,459.895,402.92],"group_id":"p22-1","quality_score":1.0},{"page":"22","line":15,"text":"2 Pro zajímavost viz přílohu 2 – upozorňující cedule na stromě přímo na lokalitě naopak hradiště označuje pouze přízviskem","bbox":[99.144,742.907,524.546,751.41],"group_id":"p22-2","quality_score":1.0},{"page":"22","line":16,"text":"„pravěké“, což je z hlediska dnešního poznání nepřesné.","bbox":[70.827,758.011,252.719,766.051],"group_id":"p22-2","quality_score":1.0},{"page":"22","line":17,"text":"22","bbox":[292.01,781.92,303.249,792.96],"group_id":"p22-3","quality_score":1.0,"style":{"region":"page_footer"}},{"page":"23","line":0,"text":"9 Seznam literatury","bbox":[70.824,79.73,191.656,93.77],"group_id":"p23-0","quality_score":1.0,"style":{"bold":true,"heading_level":3}},{"page":"23","line":1,"text":"Anonymus 2016: Plán dílčího povodí dolní Vltavy. Stav útvarů povrchových vod a program","bbox":[70.824,104.9,506.891,116.9],"group_id":"p23-1","quality_score":1.0,"style":{"italic":true}},{"page":"23","line":2,"text":"opatření v povodí horní Sázavy po soutok se Želivkou. Povodí Vltavy, státní podnik.","bbox":[70.836,121.7,473.06,133.7],"group_id":"p23-1","quality_score":1.0},{"page":"23","line":3,"text":"Bubeník, J. 1970: Příspěvek k poznání hradištního období Posázaví. Archeologické rozhledy","bbox":[70.836,148.58,510.708,160.58],"group_id":"p23-1","quality_score":1.0,"style":{"italic":true}},{"page":"23","line":4,"text":"XXII, s. 286–306.","bbox":[70.836,165.5,151.14,177.5],"group_id":"p23-1","quality_score":1.0},{"page":"23","line":5,"text":"Balatka, B. – Kalvoda, J. 2006: Geomorfologické členění reliéfu Čech. Praha.","bbox":[70.836,192.26,438.808,204.26],"group_id":"p23-1","quality_score":1.0,"style":{"italic":true}},{"page":"23","line":6,"text":"Chytrý M., Kučera T., Kočí M., Grulich V., Lustyk P. (eds) 2010: Katalog biotopů České","bbox":[70.836,219.14,524.495,231.14],"group_id":"p23-1","quality_score":1.0,"style":{"italic":true}},{"page":"23","line":7,"text":"republiky. Ed. 2. Agentura ochrany přírody a krajiny ČR, Praha.","bbox":[70.836,235.976,373.566,247.976],"group_id":"p23-1","quality_score":1.0},{"page":"23","line":8,"text":"Lutovský, M. 2001: Encyklopedie slovanské archeologie v Čechách a na Moravě. Praha: Libri.","bbox":[70.836,262.856,518.816,274.856],"group_id":"p23-1","quality_score":1.0,"style":{"italic":true}},{"page":"23","line":9,"text":"Lutovský, M. 2009: Doba hradištní bez hradišť? Úvaha nad strukturou, chronologií a","bbox":[70.836,289.736,524.411,301.736],"group_id":"p23-1","quality_score":1.0,"style":{"italic":true}},{"page":"23","line":10,"text":"terminologií raně středověkých fortifikací v Čechách.","bbox":[70.836,306.536,326.941,318.536